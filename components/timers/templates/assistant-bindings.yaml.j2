[%- from '_validate.jinja' import validate_timers with context -%]
[%- set p = inputs.prefix | default('domosenso') -%]
[%- set timers = inputs.timers | default([{'id':'general','label':'General','duration_seconds':300}]) -%]
[[ validate_timers(p, timers) ]]
[%- set subjects = [] -%]
[%- for item in timers -%]
[%- set _ = subjects.append({'key':item.id,'kind':'timer','label':item.label,'fields':{'timer':{'entity':'timer.' ~ p ~ '_' ~ item.id}}}) -%]
[%- endfor -%]
[%- set binding = {'subjects':subjects,'policies':[]} -%]
[[ binding | yaml ]]
