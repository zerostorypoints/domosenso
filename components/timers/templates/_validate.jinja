[%- macro validate_timers(prefix, timers) -%]
[%- if prefix is not string or not prefix or prefix | length > 60 -%][[ fail('timers: invalid prefix') ]][%- endif -%]
[%- for c in prefix if c not in 'abcdefghijklmnopqrstuvwxyz0123456789_' -%][[ fail('timers: prefix must be a slug') ]][%- endfor -%]
[%- if timers is string or timers is mapping or timers is not sequence or not timers or timers | length > 16 -%][[ fail('timers: expected 1 to 16 timers') ]][%- endif -%]
[%- set seen = [] -%]
[%- for item in timers -%]
[%- if item is not mapping or item.id is not string or not item.id or item.id | length > 60 or item.id in seen -%][[ fail('timers: invalid or duplicate id') ]][%- endif -%]
[%- for c in item.id if c not in 'abcdefghijklmnopqrstuvwxyz0123456789_' -%][[ fail('timers: id must be a slug') ]][%- endfor -%]
[%- set _ = seen.append(item.id) -%]
[%- if item.label is not string or not item.label | trim or item.label | length > 120 or '\n' in item.label or '\r' in item.label -%][[ fail('timers: invalid label') ]][%- endif -%]
[%- if item.duration_seconds is not integer or item.duration_seconds < 1 or item.duration_seconds > 86400 -%][[ fail('timers: duration must be integer seconds from 1 to 86400') ]][%- endif -%]
[%- endfor -%]
[%- endmacro -%]
