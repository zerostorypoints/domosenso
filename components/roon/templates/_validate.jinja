[%- macro validate_bridges(bridges) -%]
[%- if bridges is string or bridges is mapping or bridges is not sequence or bridges | length > 32 -%][[ fail('roon: volume_bridges must be a list of at most 32 bridges') ]][%- endif -%]
[%- set seen = [] -%]
[%- for b in bridges -%]
[%- if b is not mapping -%][[ fail('roon: each volume bridge is a mapping with event and amplifier') ]][%- endif -%]
[%- for key in b if key not in ('event', 'amplifier', 'steps', 'mute') -%][[ fail('roon: unknown volume bridge key ' ~ key) ]][%- endfor -%]
[%- set ev = b.get('event') -%]
[%- if ev is not string or not ev.startswith('event.') or not ev.endswith('_roon_volume') or ev | length <= 18 -%][[ fail('roon: event must be an event.<zone>_roon_volume entity, got ' ~ ev) ]][%- endif -%]
[%- for c in ev[6:] if c not in 'abcdefghijklmnopqrstuvwxyz0123456789_' -%][[ fail('roon: event must be an entity id, got ' ~ ev) ]][%- endfor -%]
[%- if ev in seen -%][[ fail('roon: two volume bridges name ' ~ ev) ]][%- endif -%]
[%- set _ = seen.append(ev) -%]
[%- set amp = b.get('amplifier') -%]
[%- if amp is not string or not amp.startswith('media_player.') or amp | length <= 13 -%][[ fail('roon: amplifier must be a media_player entity, got ' ~ amp) ]][%- endif -%]
[%- for c in amp[13:] if c not in 'abcdefghijklmnopqrstuvwxyz0123456789_' -%][[ fail('roon: amplifier must be an entity id, got ' ~ amp) ]][%- endfor -%]
[%- set steps = b.get('steps', 1) -%]
[%- if steps is not integer or steps is sameas true or steps is sameas false or steps < 1 or steps > 5 -%][[ fail('roon: steps must be an integer from 1 to 5') ]][%- endif -%]
[%- if b.get('mute', true) is not sameas true and b.get('mute', true) is not sameas false -%][[ fail('roon: mute must be true or false') ]][%- endif -%]
[%- endfor -%]
[%- endmacro -%]
