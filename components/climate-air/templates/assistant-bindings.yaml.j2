[%- set subjects = [] -%]
[%- macro add(key, kind, label, fields, extra={}) -%]
[%- set clean = {} -%]
[%- for role, entity in fields.items() if entity -%][%- set _ = clean.update({role: {'entity': entity}}) -%][%- endfor -%]
[%- if clean -%]
[%- if label is mapping -%][%- set normalized = {'en': label.values() | first} -%][%- for k,v in label.items() if k in ('en','de','pl') -%][%- set _ = normalized.update({k:v}) -%][%- endfor -%][%- else -%][%- set normalized = label -%][%- endif -%]
[%- set subject = {'key':key, 'kind':kind, 'label':normalized, 'fields':clean} -%][%- set _ = subject.update(extra) -%][%- set _ = subjects.append(subject) -%]
[%- endif -%][%- endmacro -%]
[% for item in inputs.get('climate', []) %][% set entity = item.get('temperature') or item.get('humidity') %][% if entity %][% set extra = {'indoor':item.get('indoor',true)} %][% if item.get('room') %][% set _ = extra.update({'roomKey':item.room}) %][% endif %][% set _ = add(entity,'room',item.label,{'temperature':item.get('temperature'),'humidity':item.get('humidity')},extra) %][% endif %][% endfor %]
[% for metric,entity in inputs.get('air',{}).items() if metric in ('score','co2','pm2_5','voc','nox') and entity %][% set _ = add(entity,'room',metric,{metric:entity}) %][% endfor %]
[% set outside = inputs.get('outside',{}) %][% set entity = outside.get('temperature') or outside.get('humidity') %][% if entity %][% set _ = add(entity,'room','Outside',{'temperature':outside.get('temperature'),'humidity':outside.get('humidity')},{'indoor':false}) %][% endif %]
[% if inputs.get('outside_weather') %][% set _ = add('climate-outside','room','Outside',{'temperature':'sensor.outside_temperature','humidity':'sensor.outside_humidity'},{'indoor':false}) %][% endif %]
[% set status = {} %][% if inputs.get('climate',[]) | selectattr('bathroom','defined') | selectattr('bathroom') | list %][% set _ = status.update({'humidity_alert':'binary_sensor.bathroom_humidity_high'}) %][% endif %][% if inputs.get('outside_weather') or outside.get('temperature') %][% set _ = status.update({'difference':'sensor.indoor_outdoor_difference'}) %][% endif %][% set _ = add('climate-status','room','Climate',status) %]
[%- set binding = {'subjects':subjects,'policies':[]} -%]
[[ binding | yaml ]]
