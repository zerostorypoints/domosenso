[%- set subjects = [] -%]
[%- macro add(key, kind, label, fields, extra={}) -%]
[%- set clean = {} -%]
[%- for role, entity in fields.items() if entity -%][%- set _ = clean.update({role: {'entity': entity}}) -%][%- endfor -%]
[%- if clean -%]
[%- if label is mapping -%][%- set normalized = {'en': label.values() | first} -%][%- for k,v in label.items() if k in ('en','de','pl') -%][%- set _ = normalized.update({k:v}) -%][%- endfor -%][%- else -%][%- set normalized = label -%][%- endif -%]
[%- set subject = {'key':key, 'kind':kind, 'label':normalized, 'fields':clean} -%][%- set _ = subject.update(extra) -%][%- set _ = subjects.append(subject) -%]
[%- endif -%][%- endmacro -%]
[% from '_wind-defaults.jinja' import wind_last_heard %][% for item in inputs.get('covers',[]) if item.get('entity_id') %][% set _ = add(item.entity_id,'awning',item.name,{'cover':item.entity_id},{'roomKey':item.room} if item.get('room') else {}) %][% endfor %][% set wind = inputs.get('wind_sensor') %][% if wind %][% set heard = inputs.get('wind_last_heard',wind_last_heard) %][% set _ = add(wind,'awning',inputs.get('wind_name','Awnings wind'),{'wind':wind,'last_heard':'input_datetime.' ~ heard.id}) %][% endif %]
[%- set binding = {'subjects':subjects,'policies':[]} -%]
[[ binding | yaml ]]
