[# Only explicitly identified read targets are eligible; missing wind never invents a guard. #]
[%- from 'assistant-bindings.yaml.j2' import binding with context -%]
[%- from '_wind-defaults.jinja' import wind_silent_hours -%]
[%- set wind = namespace(fields=none) -%]
[%- for subject in binding.subjects if 'wind' in subject.fields -%]
[%- set wind.fields = subject.fields -%]
[%- endfor -%]
[%- set subjects = [] -%]
[%- for subject in binding.subjects if 'cover' in subject.fields -%]
[%- set target = dict(subject) -%]
[%- if wind.fields -%]
[%- set hours = inputs.get('wind_silent_hours', wind_silent_hours) -%]
[%- set age = hours * 3600 if hours is number and hours is not boolean else hours -%]
[%- set _ = target.update({'guard': {'wind': wind.fields.wind, 'last_heard': wind.fields.last_heard, 'max_age_seconds': age}}) -%]
[%- endif -%]
[%- set _ = subjects.append(target) -%]
[%- endfor -%]
[%- set actions_binding = {'subjects': subjects, 'policies': []} -%]
[[ actions_binding | yaml ]]
