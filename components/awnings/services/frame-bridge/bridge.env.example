# Copy to bridge.env next to compose.yaml and fill in. bridge.env holds the broker password: keep it
# out of any repository.
NODE_WS=ws://espsomfy.local:8080
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=espsomfy-bridge
MQTT_PASSWORD=
# The same root topic as the node's MQTT settings and the component's mqtt_root_topic input.
ROOT_TOPIC=espsomfy
# The wind sensor's RTS address in decimal (the node's log of received frames shows it). Leave empty
# without a wind sensor.
WIND_SENSOR=
# Local time zone for the log's timestamps (the image itself runs on UTC).
TZ=Europe/Berlin
