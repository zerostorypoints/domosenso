[%- set defaults = inputs.plant_defaults | default({'min_moisture': 15, 'max_moisture': 60, 'min_conductivity': 350, 'max_conductivity': 2000, 'min_brightness': 500}) -%]
[%- set bands = ['min_moisture', 'max_moisture', 'min_conductivity', 'max_conductivity', 'min_temperature', 'max_temperature', 'min_brightness'] -%]
[%- set reading_keys = {'moisture': 'moisture', 'conductivity': 'conductivity', 'brightness': 'illuminance', 'temperature': 'temperature'} -%]
[%- macro check_sensor(entity, field) -%]
[%- if entity is not string or not entity.startswith('sensor.') or entity | length <= 7
       or entity[7:] | reject('in', 'abcdefghijklmnopqrstuvwxyz0123456789_') | list -%]
[[ fail(field ~ ' must be a sensor entity ID') ]]
[%- endif -%]
[%- endmacro -%]
[%- set managed = ['sensor.plants_unplaced_in_soil'] -%]
[%- for item in inputs.plants -%]
[%- set prefix = 'sensor.' ~ item.entity.split('.', 1)[1] ~ '_' -%]
[%- for suffix in ['illuminance_max_24h', 'moisture_min_3h', 'moisture_change_48h', 'last_watered', 'water_in_days'] -%]
[%- set _ = managed.append(prefix ~ suffix) -%]
[%- endfor -%]
[%- if item.sources is defined -%]
[%- for suffix in reading_keys.values() | list + ['status'] -%]
[%- set _ = managed.append(prefix ~ 'reading_' ~ suffix) -%]
[%- endfor -%]
[%- endif -%]
[%- endfor -%]
[#- One row per plant: object id, friendly name, sensors, thresholds. -#]
[%- set ns = namespace(rows=[]) -%]
[%- for item in inputs.plants -%]
[%- set p = item.entity.split('.', 1)[1] -%]
[%- set given = item.sensors | default({}) -%]
[%- set sensors = {'moisture': given.moisture | default('sensor.' ~ p ~ '_moisture'),
                   'conductivity': given.conductivity | default('sensor.' ~ p ~ '_conductivity'),
                   'brightness': given.brightness | default('sensor.' ~ p ~ '_illuminance'),
                   'temperature': given.temperature | default('sensor.' ~ p ~ '_temperature')} -%]
[%- set source = none -%]
[%- set source_moisture = [] -%]
[%- set legacy = item.legacy_moisture_history | default(none) -%]
[%- if item.sources is defined or item.active_source is defined -%]
[%- if item.sensors is defined or item.sources is not mapping or not item.sources
       or item.active_source is not string or item.active_source not in item.sources -%]
[[ fail(item.entity ~ ': sources and a valid active_source are required together, without sensors') ]]
[%- endif -%]
[%- for name, binding in item.sources.items() -%]
[%- set field = item.entity ~ '.sources.' ~ name -%]
[%- if name is not string or not name or binding is not mapping or binding | length != reading_keys | length or binding.keys() | reject('in', reading_keys) | list -%]
[[ fail(field ~ ': supply moisture, conductivity, brightness and temperature') ]]
[%- endif -%]
[%- set _ = source_moisture.append(binding.moisture) -%]
[%- for key, entity in binding.items() -%]
[[ check_sensor(entity, field ~ '.' ~ key) ]]
[%- if entity in managed -%]
[[ fail(field ~ '.' ~ key ~ ' must not reference a managed plant reading') ]]
[%- endif -%]
[%- endfor -%]
[%- endfor -%]
[%- set source = item.sources[item.active_source] -%]
[%- set sensors = {} -%]
[%- for key, suffix in reading_keys.items() -%]
[%- set _ = sensors.update({key: 'sensor.' ~ p ~ '_reading_' ~ suffix}) -%]
[%- endfor -%]
[%- endif -%]
[%- if legacy is not none -%]
[%- set field = item.entity ~ '.legacy_moisture_history' -%]
[%- if source is none or legacy is not mapping or legacy | length != 2 or 'before' not in legacy or 'statistic_id' not in legacy -%]
[[ fail(field ~ ': requires sources, statistic_id and before') ]]
[%- endif -%]
[[ check_sensor(legacy.statistic_id, field ~ '.statistic_id') ]]
[%- if legacy.statistic_id in managed or legacy.before is not iso_timestamp -%]
[[ fail(field ~ ': give the previous sensor ID and a quoted ISO 8601 timestamp with time zone') ]]
[%- endif -%]
[%- endif -%]
[%- set limits = {} -%]
[%- for band in bands -%]
[%- if item[band] is defined -%][%- set _ = limits.update({band: item[band]}) -%]
[%- elif band in defaults -%][%- set _ = limits.update({band: defaults[band]}) -%]
[%- endif -%]
[%- endfor -%]
[#- A name or label may be given per language ({en: …, de: …, pl: …}): the first value is the
    friendly name and the room; the map goes to the Ramka, which shows each dashboard's language. -#]
[%- set given_name = item.name | default(item.label) -%]
[%- set ns.rows = ns.rows + [{'id': p, 'name': given_name if given_name is string else given_name.values() | first,
                              'label': item.label if item.label is string else item.label.values() | first,
                              'names': given_name if given_name is mapping else none,
                              'rooms': item.label if item.label is mapping else none, 'photo': item.photo | default(none), 'sensors': sensors, 'source': source, 'source_moisture': source_moisture, 'legacy': legacy, 'limits': limits, 'check_days': item.check_days | default(defaults.check_days | default(3))}] -%]
[%- endfor -%]
[%- set rows = ns.rows -%]
