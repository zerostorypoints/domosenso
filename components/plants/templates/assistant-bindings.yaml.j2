[%- from '_plant-rows.jinja' import rows with context -%]
[%- set subjects = [] -%]
[%- for row in rows -%]
[%- set item = inputs.plants[loop.index0] -%]
[%- set fields = {} -%]
[#- A hydroculture plant (SPEC-048) binds no soil reading and no watering figure: its watering
    questions stay unanswered rather than read the pebbles. -#]
[%- for role, entity in row.sensors.items() if not (row.hydro and role in ['moisture', 'conductivity']) -%][%- set _ = fields.update({role: {'entity': entity}}) -%][%- endfor -%]
[%- for role, entity in {'plant': item.entity, 'last_watered': 'sensor.' ~ row.id ~ '_last_watered',
 'water_in_days': 'sensor.' ~ row.id ~ '_water_in_days', 'drying_rate': 'sensor.' ~ row.id ~ '_moisture_change_48h',
 'brightness_peak': 'sensor.' ~ row.id ~ '_illuminance_max_24h'}.items()
   if not (row.hydro and role in ['last_watered', 'water_in_days', 'drying_rate']) -%]
[%- set _ = fields.update({role: {'entity': entity}}) -%][%- endfor -%]
[%- set label = row.name -%]
[%- if row.names -%][%- set label = {'en': row.name} -%][%- for k,v in row.names.items() if k in ('en','de','pl') -%][%- set _ = label.update({k:v}) -%][%- endfor -%][%- endif -%]
[%- set room_label = row.label -%]
[%- if row.rooms -%][%- set room_label = {'en': row.label} -%][%- for k,v in row.rooms.items() if k in ('en','de','pl') -%][%- set _ = room_label.update({k:v}) -%][%- endfor -%][%- endif -%]
[%- set limits = dict(row.limits) -%][%- set _ = limits.update({'check_days': row.check_days}) -%]
[%- set subject = {'key': item.entity, 'kind':'plant', 'label':label, 'roomLabel':room_label, 'fields':fields, 'limits':limits} -%]
[%- if item.get('room') -%][%- set _ = subject.update({'roomKey':item.room}) -%][%- endif -%]
[%- set _ = subjects.append(subject) -%]
[%- endfor -%]
[%- set binding = {'subjects':subjects,'policies':[]} -%]
[[ binding | yaml ]]
