[#
  The plants component's Home Assistant package (SPEC-006): plant entities, the 24-hour light peak,
  the water reminder and the silent-sensor alert. Rendered once per home (lang en) by
  tools/domosenso_render.py; double square brackets are the renderer's, {{ }} / {% %} stay for Home
  Assistant. Inputs: component.yaml `inputs:`.
#]
[%- set defaults = inputs.plant_defaults | default({'min_moisture': 15, 'max_moisture': 60, 'min_conductivity': 350, 'max_conductivity': 2000, 'min_brightness': 500}) -%]
[%- set bands = ['min_moisture', 'max_moisture', 'min_conductivity', 'max_conductivity', 'min_temperature', 'max_temperature', 'min_brightness'] -%]
[%- set notify_from = inputs.notify_from | default('08:00:00') -%]
[%- set notify_until = inputs.notify_until | default('21:00:00') -%]
[%- set dry_for = inputs.dry_for | default('01:00:00') -%]
[%- set silent_hours = inputs.silent_hours | default(6) -%]
[#- One row per plant: object id, friendly name, sensors, thresholds. -#]
[%- set ns = namespace(rows=[]) -%]
[%- for item in inputs.plants -%]
[%- set p = item.entity.split('.', 1)[1] -%]
[%- set given = item.sensors | default({}) -%]
[%- set sensors = {'moisture': given.moisture | default('sensor.' ~ p ~ '_moisture'),
                   'conductivity': given.conductivity | default('sensor.' ~ p ~ '_conductivity'),
                   'brightness': given.brightness | default('sensor.' ~ p ~ '_illuminance'),
                   'temperature': given.temperature | default('sensor.' ~ p ~ '_temperature')} -%]
[%- set limits = {} -%]
[%- for band in bands -%]
[%- if item[band] is defined -%][%- set _ = limits.update({band: item[band]}) -%]
[%- elif band in defaults -%][%- set _ = limits.update({band: defaults[band]}) -%]
[%- endif -%]
[%- endfor -%]
[%- set ns.rows = ns.rows + [{'id': p, 'name': item.name | default(item.label), 'label': item.label, 'photo': item.photo | default(none), 'sensors': sensors, 'limits': limits, 'check_days': item.check_days | default(defaults.check_days | default(3))}] -%]
[%- endfor -%]
[%- set rows = ns.rows -%]
[%- set watered = rows | selectattr('limits.min_moisture', 'defined') | list -%]
[%- set watered_list = watered | map(attribute='sensors.moisture') | list | tojson | replace('"', "'") -%]
[%- set thresholds = watered | map(attribute='limits.min_moisture') | unique | list -%]
[%- macro row_limit(row) -%][[ row.limits.min_moisture ]][%- endmacro -%]
[%- macro row_plant(row) -%]'plant.[[ row.id ]]'[%- endmacro -%]
[%- macro sensor_map(items, value) -%]
{[% for row in items %]'[[ row.sensors.moisture ]]': [[ value(row) ]][% if not loop.last %], [% endif %][% endfor %]}
[%- endmacro -%]
[%- set silent_for = '%02d:00:00' % silent_hours -%]
[%- set known_list = rows | map(attribute='sensors.moisture') | list | tojson | replace('"', "'") -%]
[#- The Xiaomi BLE moisture sensors no plant uses that read more than 0 %: a sensor out of its pot
    reads 0 %, so one appearing here was just pushed into soil (SPEC-022). -#]
[%- macro unplaced() -%]
{% set ns = namespace(out=[]) %}
{% set known = [[ known_list ]] %}
{% for e in integration_entities('xiaomi_ble') | select('search', '_moisture$') | reject('in', known) %}
  {% if states(e) | float(0) > 0 %}
    {% set ns.out = ns.out + [{'entity': e, 'device': device_attr(device_id(e), 'name_by_user') or device_attr(device_id(e), 'name') or e, 'value': states(e) | float}] %}
  {% endif %}
{% endfor %}
[%- endmacro -%]
# Houseplants, from the Domosenso catalog (component plants). Edit the inputs and render again
# rather than editing this file.
#
# Mi Flora sensors reach Home Assistant through the Bluetooth proxies; Xiaomi BLE discovers them on
# its own. The brightness threshold is compared with the brightest reading of the last check_days,
# not the current one.

homeassistant:
  customize:
[%- for row in rows %]
    plant.[[ row.id ]]:
      friendly_name: [[ row.name | yaml ]]
      # Read by the Ramka's plants card (SPEC-022): the marker, the room shown, the limits the plant
      # integration does not expose, and the photo.
      domosenso_plant: true
      domosenso_room: [[ row.label | yaml ]]
      domosenso_bands: [[ row.limits | yaml ]]
[%- if row.photo %]
      entity_picture: [[ row.photo | yaml ]]
[%- endif %]
[%- set watered_name = row.name ~ ' last watered' %]
[%- set water_in_name = row.name ~ ' water in' %]
    sensor.[[ row.id ]]_last_watered:
      friendly_name: [[ watered_name | yaml ]]
    sensor.[[ row.id ]]_water_in_days:
      friendly_name: [[ water_in_name | yaml ]]
[%- set peak_name = row.name ~ ' illuminance max 24h' %]
    sensor.[[ row.id ]]_illuminance_max_24h:
      friendly_name: [[ peak_name | yaml ]]
[%- endfor %]

plant:
[%- for row in rows %]
  [[ row.id ]]:
    sensors:
      moisture: [[ row.sensors.moisture ]]
      conductivity: [[ row.sensors.conductivity ]]
      brightness: [[ row.sensors.brightness ]]
      temperature: [[ row.sensors.temperature ]]
[%- for band in bands if band in row.limits %]
    [[ band ]]: [[ row.limits[band] ]]
[%- endfor %]
    check_days: [[ row.check_days ]]
[%- endfor %]

# Brightest reading of the last 24 hours per plant, for light gauges: the current reading is zero
# every night, which says nothing about whether the spot is bright enough. The name carries the
# object id so that a fresh registry gives the same entity id; customize above gives the readable name.
sensor:
[%- for row in rows %]
  - platform: statistics
    name: [[ row.id ]] illuminance max 24h
    unique_id: [[ row.id ]]_illuminance_max_24h
    entity_id: [[ row.sensors.brightness ]]
    state_characteristic: value_max
    max_age:
      hours: 24
  # The lowest moisture of the last 3 hours, for a watering that soaks in slowly, and the change
  # over 48 hours, the drying rate behind "water in".
  - platform: statistics
    name: [[ row.id ]] moisture min 3h
    unique_id: [[ row.id ]]_moisture_min_3h
    entity_id: [[ row.sensors.moisture ]]
    state_characteristic: value_min
    max_age:
      hours: 3
  - platform: statistics
    name: [[ row.id ]] moisture change 48h
    unique_id: [[ row.id ]]_moisture_change_48h
    entity_id: [[ row.sensors.moisture ]]
    state_characteristic: change
    max_age:
      hours: 48
[%- endfor %]

template:
[%- for row in rows %]
  # Watered: a rise of 10 points between two readings (a watering shows within a minute), or 10
  # points above the 3-hour minimum for one that soaks in slowly, at most once in 3 hours. The first
  # reading after a start comes from nothing or from unavailable, which is_number(f) refuses.
  - triggers:
      - trigger: state
        entity_id: [[ row.sensors.moisture ]]
    sensor:
      - name: [[ row.id ]] last watered
        unique_id: [[ row.id ]]_last_watered
        device_class: timestamp
        availability: "{{ has_value('[[ row.sensors.moisture ]]') }}"
        state: >
          {% set f = trigger.from_state.state if trigger.from_state else 'unknown' %}
          {% set t = trigger.to_state.state %}
          {% set last = as_datetime(this.state, none) if this is defined else none %}
          {% set rise = is_number(f) and is_number(t) and (t | float - f | float) >= 10 %}
          {% set soak = is_number(f) and is_number(t) and has_value('sensor.[[ row.id ]]_moisture_min_3h')
             and (t | float - states('sensor.[[ row.id ]]_moisture_min_3h') | float) >= 10
             and (last is none or now() - last > timedelta(hours=3)) %}
          {{ now().isoformat() if rise or soak else (last.isoformat() if last is not none else none) }}
[%- endfor %]
  - sensor:
[%- for row in rows %]
      # Whole days until the moisture reaches the minimum at the last 48 hours' rate; unknown within
      # 48 hours of a watering (the change would include it) or while the soil is not drying.
      - name: [[ row.id ]] water in days
        unique_id: [[ row.id ]]_water_in_days
        unit_of_measurement: d
        availability: "{{ has_value('[[ row.sensors.moisture ]]') }}"
        state: >
          {% set m = states('[[ row.sensors.moisture ]]') | float(none) %}
          {% set c = states('sensor.[[ row.id ]]_moisture_change_48h') | float(none) %}
          {% set w = as_datetime(states('sensor.[[ row.id ]]_last_watered'), none) %}
          {% if m is none or c is none or c >= 0 or (w is not none and now() - w < timedelta(hours=48)) %}
            {{ none }}
          {% else %}
            {{ [0, ((m - [[ row.limits.min_moisture | default(15) ]]) / (-c / 2)) | round(0, 'floor') | int] | max }}
          {% endif %}
[%- endfor %]
      - name: Plants unplaced in soil
        unique_id: plants_unplaced_in_soil
        state: >
          [[ unplaced() | indent(10) ]]
          {{ ns.out | count }}
        attributes:
          sensors: >
            [[ unplaced() | indent(12) ]]
            {{ ns.out }}

automation:
[%- if watered %]
  # A plant is reported once when it dries out during the day, and at [[ notify_from[:5] ]] every morning while
  # it stays dry, so at most once a day each. A crossing outside [[ notify_from[:5] ]]-[[ notify_until[:5] ]] waits for the
  # morning run rather than waking anyone. numeric_state and has_value skip unavailable and missing
  # sensors, so nothing fires before the sensors exist or while one is out of range.
  - id: plants_water_reminder
    alias: Plants need water
    description: Push a notification when a plant's soil moisture is below its minimum.
    mode: queued
    triggers:
[%- for limit in thresholds %]
      - trigger: numeric_state
        entity_id:
[%- for row in watered if row.limits.min_moisture == limit %]
          - [[ row.sensors.moisture ]]
[%- endfor %]
        below: [[ limit ]]
        for: [[ dry_for | yaml ]]
        id: dried_out
[%- endfor %]
      - trigger: time
        at: [[ notify_from | yaml ]]
        id: morning
    conditions:
      - condition: or
        conditions:
          - condition: trigger
            id: morning
          - condition: time
            after: [[ notify_from | yaml ]]
            before: [[ notify_until | yaml ]]
    variables:
      sensors: >
        {{ [trigger.entity_id] if trigger.id == 'dried_out' else
           [[ watered_list ]] }}
      dry: >
        {% set limits = [[ sensor_map(watered, row_limit) ]] %}
        {% set plants = [[ sensor_map(watered, row_plant) ]] %}
        {% set ns = namespace(out=[]) %}
        {% for s in sensors if has_value(s) and states(s) | float(100) < limits[s] %}
          {% set plant = plants[s] %}
          {% set name = state_attr(plant, 'friendly_name') or plant.replace('plant.', '') %}
          {% set ns.out = ns.out + [name ~ ' (' ~ states(s) ~ ' %)'] %}
        {% endfor %}
        {{ ns.out }}
    actions:
      - condition: template
        value_template: "{{ dry | count > 0 }}"
      - action: [[ inputs.notify ]]
        data:
          title: Plants need water
          message: "{{ dry | join(', ') }}"
[%- endif %]

  # The sensors report no battery level through the proxies, so a sensor that stops reporting is how
  # a flat CR2032, or a pot moved out of proxy range, shows up. Xiaomi BLE marks the sensor
  # unavailable when its advertisements stop.
  - id: plants_sensor_silent
    alias: Plant sensor silent
    description: Push a notification when a plant sensor has been unavailable for [[ silent_hours ]] hours.
    mode: queued
    triggers:
      - trigger: state
        entity_id:
[%- for row in rows %]
          - [[ row.sensors.moisture ]]
[%- endfor %]
        to: unavailable
        for: [[ silent_for | yaml ]]
    actions:
      - action: [[ inputs.notify ]]
        data:
          title: Plant sensor silent
          message: >
            {% set plant = [[ sensor_map(rows, row_plant) ]][trigger.entity_id] %}
            {{ state_attr(plant, 'friendly_name') or plant | replace('plant.', '') }} has sent
            nothing for [[ silent_hours ]] hours. Replace the CR2032, or check it is in range of a Bluetooth proxy.

  # A sensor that joins the unplaced list was just pushed into a pot: name it, so the home knows
  # which device to rename and give to a plant (onboarding, README). Not on a start: the list is
  # rebuilt then and would announce every sensor already in soil.
  - id: plants_sensor_new
    alias: Plant sensor new
    description: Push a notification when a Mi Flora sensor no plant uses is pushed into soil.
    mode: queued
    triggers:
      - trigger: state
        entity_id: sensor.plants_unplaced_in_soil
        attribute: sensors
    conditions:
      - condition: template
        value_template: "{{ trigger.from_state is not none and trigger.from_state.state not in ['unknown', 'unavailable'] }}"
    variables:
      new: >
        {% set before = (trigger.from_state.attributes.sensors or []) | map(attribute='entity') | list %}
        {{ (trigger.to_state.attributes.sensors or []) | rejectattr('entity', 'in', before) | list }}
      text: >
        {{ new | map(attribute='device') | zip(new | map(attribute='value')) | map('join', ': ') | join(' %, ') ~ ' %' }}
    actions:
      - condition: template
        value_template: "{{ new | count > 0 }}"
      - action: persistent_notification.create
        data:
          title: New plant sensor in a pot
          message: "{{ text }}"
      - action: [[ inputs.notify ]]
        data:
          title: New plant sensor in a pot
          message: "{{ text }}"
