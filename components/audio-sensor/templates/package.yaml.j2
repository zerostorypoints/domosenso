[#
  The audio-sensor component's Home Assistant package (SPEC-018, SPEC-021): the per-board SPL offset
  and calibration flag and note, the recorder exclusions, the music-source select, the music aliases,
  the calibration script, and the spectrum rate choice with its watching flag and forwarding (#99, #110). Rendered once per home (lang en) by
  tools/domosenso_render.py; double square brackets are the renderer's, {{ }} / {% %} stay for Home
  Assistant. Inputs: component.yaml `inputs:`.
#]
[%- set boards = inputs.sensors -%]
[#- Room acoustics was dropped before 0.1.0 shipped (SPEC-018, amended 2026-10-29): no bridge, a clear refusal. -#]
[%- for removed in ['room_acoustics', 'playing'] -%]
  [%- if removed in inputs -%][[ fail('input ' ~ removed ~ ' was removed: room acoustics is not part of audio-sensor; delete it from the inputs file') ]][%- endif -%]
[%- endfor -%]
[%- set strip_keys = ['leds', 'pin', 'follow', 'ambient_light', 'entities'] -%]
[%- set strip_guess = {'light': ('light', 'music_strip'), 'palette': ('select', 'strip_palette'), 'custom_palette': ('text', 'strip_custom_palette'), 'intensity': ('number', 'strip_intensity'), 'mounting': ('select', 'strip_mounting'), 'power_limit': ('number', 'strip_power_limit'), 'current': ('sensor', 'strip_current')} -%]
[%- set known = ['spectrum', 'level', 'peak', 'fast_level', 'fast_peak', 'live_tracking', 'mic_gain', 'wifi_signal', 'uptime', 'bssid', 'restart', 'load', 'spectrum_rate'] -%]
[#- A board's ids: the prefix of what this component creates, and the guessed ids of the ESPHome entities when `entities` does not name them (the area slug and the device name slug that Home Assistant builds them from). -#]
[%- from '_audio-ids.jinja' import to_slug -%]
[%- macro guess(board, domain, entity_slug) -%][[ domain ]].[[ to_slug(board.area) ]]_[[ to_slug(board.name | default('audio-sensor-' ~ board.room)) ]]_[[ entity_slug ]][%- endmacro -%]
[#- A Home Assistant template string literal: double quotes, so an apostrophe in an area ("Kids' room") needs no escape. -#]
[%- macro jstr(text) -%]"[[ text | replace("\\", "\\\\") | replace('"', '\\"') ]]"[%- endmacro -%]
[%- set ns = namespace(rooms=[], prefixes=[], music=[], prepared=[]) -%]
[%- for board in boards -%]
  [%- set prefix = board.id_prefix | default(to_slug(board.room)) -%]
  [%- if 'acoustics' in board -%][[ fail('input sensors[].acoustics was removed: room acoustics is not part of audio-sensor; delete it from the inputs file') ]][%- endif -%]
  [%- if board.room in ns.rooms -%][[ fail('duplicate room: ' ~ board.room) ]][%- endif -%]
  [%- if prefix in ns.prefixes -%][[ fail('duplicate id_prefix: ' ~ prefix) ]][%- endif -%]
  [%- for key in (board.entities | default({})) -%]
    [%- if key not in known -%][[ fail('unknown entity key: ' ~ key) ]][%- endif -%]
  [%- endfor -%]
  [#- SPEC-043: the strip on the board's Grove port. Its firmware entities' ids, like the others, are guessed when `strip.entities` does not name them. -#]
  [%- set strip = board.strip if board.strip is defined and board.strip is not none else none -%]
  [%- set strip_item = none -%]
  [%- if strip is not none -%]
    [%- for key in strip -%]
      [%- if key not in strip_keys -%][[ fail('unknown strip key: ' ~ key) ]][%- endif -%]
    [%- endfor -%]
    [%- set leds = strip.leds | default(120) -%]
    [%- if leds is not number or leds < 1 or leds > 300 -%][[ fail('strip.leds must be 1 to 300: ' ~ leds) ]][%- endif -%]
    [%- for key in ['follow', 'ambient_light'] -%]
      [%- if strip[key] is defined and strip[key] is not none and not (strip[key] is string and strip[key] == strip[key] | lower and ' ' not in strip[key] and (strip[key].split('.') | select | list | length) == 2 and (strip[key].split('.') | length) == 2) -%][[ fail('strip.' ~ key ~ ' is not an entity id: ' ~ strip[key]) ]][%- endif -%]
    [%- endfor -%]
    [%- set strip_entities = strip.entities | default({}) -%]
    [%- for key in strip_entities -%]
      [%- if key not in strip_guess -%][[ fail('unknown strip entity key: ' ~ key) ]][%- endif -%]
    [%- endfor -%]
    [%- set strip_item = {'follow': strip.follow | default(none), 'ambient_light': strip.ambient_light | default(none)} -%]
    [%- for key, (domain, slug) in strip_guess.items() -%]
      [%- set _ = strip_item.update({key: strip_entities[key] | default(guess(board, domain, slug))}) -%]
    [%- endfor -%]
  [%- endif -%]
  [%- set spectrum = (board.entities | default({})).spectrum | default(guess(board, 'sensor', 'spectrum')) -%]
  [%- set level = (board.entities | default({})).level | default(guess(board, 'sensor', 'sound_level')) -%]
  [%- set ns.rooms = ns.rooms + [board.room] -%]
  [%- set ns.prefixes = ns.prefixes + [prefix] -%]
  [%- set item = {
    'room': board.room, 'area': board.area, 'prefix': prefix, 'label': board.area ~ ' SPL offset', 'calibrated_label': board.area ~ ' SPL calibrated', 'note_label': board.area ~ ' SPL note',
    'spectrum': spectrum, 'level': level,
    'mic_gain': (board.entities | default({})).mic_gain | default(guess(board, 'sensor', 'mic_gain')),
    'spectrum_rate': (board.entities | default({})).spectrum_rate | default(guess(board, 'select', 'spectrum_rate')),
    'offset': 'input_number.' ~ prefix ~ '_spl_offset',
    'calibrated': 'input_boolean.' ~ prefix ~ '_spl_calibrated',
    'note': 'input_text.' ~ prefix ~ '_spl_note',
    'strip': strip_item,
    'strip_light': strip_item.light if strip_item else '',
    'strip_palette': strip_item.palette if strip_item else '',
    'strip_custom': strip_item.custom_palette if strip_item else ''
  } -%]
  [%- set ns.prepared = ns.prepared + [item] -%]
  [%- if board.music | default(false) -%][%- set ns.music = ns.music + [item] -%][%- endif -%]
[%- endfor -%]
[%- if ns.music | length > 1 -%][[ fail('two music sensors: ' ~ (ns.music | map(attribute='room') | join(', '))) ]][%- endif -%]
[%- set source = (ns.music | first) if ns.music else none -%]
[#- The select's boards: the music board first, then the others in input order. The select adds `—` (no sensor): last after a music board, first without one. -#]
[%- set none_option = '\u2014' -%]
[%- set ordered = ([source] + (ns.prepared | rejectattr('room', 'equalto', source.room) | list)) if source else ns.prepared -%]
[%- set seen = namespace(areas=[]) -%]
[%- for b in ordered -%]
  [%- if b.area in seen.areas -%][[ fail('duplicate area: ' ~ b.area) ]][%- endif -%]
  [%- set seen.areas = seen.areas + [b.area] -%]
[%- endfor -%]
[#- SPEC-043: the strip's entities render only when a board has a strip, so a home without one gets the package as before. -#]
[%- set strips = ns.prepared | selectattr('strip') | list -%]
[%- set follows = strips | selectattr('strip.follow') | list -%]
[%- set ambients = strips | selectattr('strip.ambient_light') | list -%]
[#- A Home Assistant dict literal from the select's area to one field of that board, and the lookup with the select's state. A state that is not an option (`unknown` at a first start, `unavailable` while the helper is missing) reads the `music: true` board; keep that fallback in the lookup. -#]
[#- `—` maps to "" (no entity), so every alias reads nothing; a state that is no option reads the music board, or "" when there is none. -#]
[%- macro board_map(field) -%]{[% for b in ordered %][[ jstr(b.area) ]]: [[ jstr(b[field]) ]], [% endfor %][[ jstr(none_option) ]]: ""}[%- endmacro -%]
[%- macro fallback(field) -%][[ jstr(source[field]) if source else '""' ]][%- endmacro -%]
[%- macro lookup(field) -%][[ board_map(field) ]].get(states("input_select.audio_sensor_music_source"), [[ fallback(field) ]])[%- endmacro -%]
[#- The aliases' availability: a board is selected and its entity has a value. -#]
[%- macro available(field) -%]{% set entity = [[ lookup(field) ]] %}{{ entity != '' and has_value(entity) }}[%- endmacro -%]
[#- The abilities' expressions (SPEC-025): an ability is what the board can do, not whether it sends data now. An existing entity that is unavailable or unknown keeps its ability; a missing one, or no sensor (""), has none. `ability(kind)` sets a Home Assistant variable named `kind`. -#]
[%- set gone = "['unavailable', 'unknown']" -%]
[%- set ability_field = {'spectrum': 'spectrum', 'level': 'level', 'calibration': 'level', 'rate': 'spectrum_rate', 'gain': 'mic_gain', 'strip': 'strip_light'} -%]
[%- macro ability(kind) -%]
{% set e = [[ lookup(ability_field[kind]) ]] %}{% set here = e != '' and expand(e) | count == 1 %}
[%- if kind == 'spectrum' -%]
{% set spectrum = here and (states(e) in [[ gone ]] or states(e).split(',') | count == 31) %}
[%- elif kind in ['level', 'calibration'] -%]
{% set [[ kind ]] = here and (states(e) in [[ gone ]] or states(e) | is_number) %}
[%- elif kind == 'rate' -%]
{% set options = state_attr(e, 'options') %}{% set rate = here and ((options is none and states(e) in [[ gone ]]) or (options is not none and ['eco', 'normal', 'fast'] | reject('in', options) | list | count == 0)) %}
[%- elif kind == 'strip' -%]
{% set strip = here %}
[%- else -%]
{% set gain = here %}
[%- endif -%]
[%- endmacro -%]
# Room sound figures, from the Domosenso catalog (component audio-sensor). Edit the inputs and render
# again rather than editing this file.
#
# Each board gets a calibration offset (dB SPL = dBFS + offset): a helper to type it in and a sensor
# that shows it. A fresh helper starts at 0; the component's README says how to measure the offset.
# No helper has an `initial:`, so a restart keeps the calibrated values. Each board also has a flag
# (`<prefix>_spl_calibrated`, off = the offset is an estimate) and a note.

input_number:
[%- if boards %]
  # The measurement the apply script writes into the selected board's offset helper.
  audio_sensor_measured_offset:
    name: Audio sensor measured offset
    min: 0
    max: 140
    step: 0.1
    mode: box
    unit_of_measurement: dB
    icon: mdi:ruler
[%- endif %]
[%- for b in ns.prepared %]
  [[ b.prefix ]]_spl_offset:
    name: [[ b.label | yaml ]]
    min: 0
    max: 140
    step: 0.1
    mode: box
    unit_of_measurement: dB
    icon: mdi:ear-hearing
[%- endfor %]
[%- for b in ambients %]
  # SPEC-043: the room's light level to the strip's brightness, linear in log lux between dark and bright.
  [[ b.prefix ]]_strip_ambient_dark_lux:
    name: [[ jstr(b.area ~ ' strip dark at') ]]
    min: 0
    max: 10000
    step: 1
    mode: box
    unit_of_measurement: lx
    icon: mdi:weather-night
  [[ b.prefix ]]_strip_ambient_bright_lux:
    name: [[ jstr(b.area ~ ' strip bright at') ]]
    min: 0
    max: 10000
    step: 1
    mode: box
    unit_of_measurement: lx
    icon: mdi:weather-sunny
  [[ b.prefix ]]_strip_ambient_min_pct:
    name: [[ jstr(b.area ~ ' strip brightness in the dark') ]]
    min: 0
    max: 100
    step: 1
    unit_of_measurement: "%"
    icon: mdi:brightness-4
  [[ b.prefix ]]_strip_ambient_max_pct:
    name: [[ jstr(b.area ~ ' strip brightness in daylight') ]]
    min: 0
    max: 100
    step: 1
    unit_of_measurement: "%"
    icon: mdi:brightness-7
[%- endfor %]
[%- for b in follows %]
  [[ b.prefix ]]_strip_follow_off_delay:
    name: [[ jstr(b.area ~ ' strip off delay') ]]
    min: 0
    max: 600
    step: 5
    mode: box
    unit_of_measurement: s
    icon: mdi:timer-sand
[%- endfor %]

# Per board: whether the offset was measured (off = an estimate) and a note on how.
input_boolean:
[%- for b in ns.prepared %]
  [[ b.prefix ]]_spl_calibrated:
    name: [[ b.calibrated_label | yaml ]]
    icon: mdi:check-decagram
[%- endfor %]
[%- for b in ambients %]
  # SPEC-043: on, the strip's brightness follows [[ b.strip.ambient_light ]]. No initial: a fresh
  # helper starts off; the README says to turn it on and set the curve.
  [[ b.prefix ]]_strip_ambient:
    name: [[ jstr(b.area ~ ' strip follows room light') ]]
    icon: mdi:brightness-auto
[%- endfor %]
[%- for b in follows %]
  # SPEC-043: on, the strip turns on while [[ b.strip.follow ]] plays and off after the delay.
  [[ b.prefix ]]_strip_follow_music:
    name: [[ jstr(b.area ~ ' strip follows music') ]]
    icon: mdi:music-circle
[%- endfor %]
[%- if boards %]
  # On while some view shows the music visual (the Ramka sets it): the spectrum rate `fast` applies
  # only then. One flag per home; no `initial:`, a restart keeps what the views last said.
  audio_sensor_music_watching:
    name: Audio sensor music watching
    icon: mdi:eye
[%- endif %]

input_text:
[%- for b in ns.prepared %]
  [[ b.prefix ]]_spl_note:
    name: [[ b.note_label | yaml ]]
    max: 255
    icon: mdi:note-text
[%- endfor %]
[%- if boards %]
  audio_sensor_calibration_note:
    name: Audio sensor calibration note
    max: 255
    icon: mdi:note-edit
[%- endif %]
[%- if boards %]

# Which board feeds the music aliases, or `—` for none. The helper has no `initial:`: a restart keeps
# the choice, and a fresh one reads `unknown`, which the aliases treat as the `music: true` board (as
# none when no board is marked).
input_select:
  audio_sensor_music_source:
    name: Audio sensor music source
    icon: mdi:microphone-message
    options:
[%- if not source %]
      - [[ none_option | yaml ]]
[%- endif %]
[%- for b in ordered %]
      - [[ b.area | yaml ]]
[%- endfor %]
[%- if source %]
      - [[ none_option | yaml ]]
[%- endif %]
  # How often the music board publishes its spectrum: eco 500 ms, normal 200 ms, fast every 85 ms
  # (the newest frame). No `initial:`, which would undo the choice at every restart; normal comes
  # first because a fresh helper takes the first option (eco first started a new home on eco).
  audio_sensor_music_spectrum_rate:
    name: Audio sensor music spectrum rate
    icon: mdi:timer-cog-outline
    options:
      - normal
      - eco
      - fast
[%- endif %]
[%- for b in follows %]
  # The style the strip turns on with; keep leaves the light's last effect.
  [[ b.prefix ]]_strip_follow_effect:
    name: [[ jstr(b.area ~ ' strip follow effect') ]]
    icon: mdi:led-strip-variant
    options:
      - keep
      - Pulse
      - Glow
      - Bands
      - Centre meter
      - Spectrum
      - Ripple
[%- endfor %]

# The spectrum (31 values, five times a second) is only for the live wave, never for history.
recorder:
  exclude:
    entities:
[%- for b in ns.prepared %]
      - [[ b.spectrum ]]
[%- endfor %]
[%- if boards %]
      - sensor.music_spectrum
[%- endif %]

template:
  - sensor:
[%- for b in ns.prepared %]
      - name: [[ b.label | yaml ]]
        unique_id: audio_sensor_[[ b.prefix ]]_spl_offset
        default_entity_id: sensor.[[ b.prefix ]]_spl_offset
        unit_of_measurement: dB
        state_class: measurement
        state: "{{ states('input_number.[[ b.prefix ]]_spl_offset') | float(none) }}"
        attributes:
          component: audio-sensor
          area: [[ b.area | yaml ]]
          # room-meter-card drops its "estimated" note while this is true.
          calibrated: "{{ is_state('input_boolean.[[ b.prefix ]]_spl_calibrated', 'on') }}"
[%- endfor %]
[%- if boards %]
      # The music sensor, under names that do not depend on the room. Each alias looks up the board
      # whose area the select holds, in a map rendered here; the lookup is a dict get and one more
      # states() call, cheap enough for the spectrum, which changes five times a second. A select
      # that is unavailable, unknown or holds no board's area falls back to the `music: true` board,
      # the last argument of every lookup (to none when no board is marked). `—` (no sensor) and a
      # missing entity make an alias unavailable, in `availability`, not in the cheap state.
      - name: Music spectrum
        unique_id: audio_sensor_music_spectrum
        default_entity_id: sensor.music_spectrum
        icon: mdi:equalizer
        availability: >-
          [[ available('spectrum') ]]
        state: >-
          {{ states([[ lookup('spectrum') ]]) }}
        attributes:
          component: audio-sensor
      - name: Music SPL offset
        unique_id: audio_sensor_music_spl_offset
        default_entity_id: sensor.music_spl_offset
        availability: >-
          [[ available('offset') ]]
        unit_of_measurement: dB
        state_class: measurement
        state: >-
          {{ states([[ lookup('offset') ]]) | float(none) }}
        attributes:
          component: audio-sensor
          calibrated: >-
            {{ is_state([[ lookup('calibrated') ]], 'on') }}
      # dBFS plus the offset is dB SPL. No number from the source (or from the offset) gives none,
      # never the text unknown.
      - name: Music level
        unique_id: audio_sensor_music_level
        default_entity_id: sensor.music_level
        availability: >-
          [[ available('level') ]]
        device_class: sound_pressure
        unit_of_measurement: dB
        state_class: measurement
        attributes:
          component: audio-sensor
        state: >-
          {% set level = states([[ lookup('level') ]]) | float(none) %}
          {% set offset = states([[ lookup('offset') ]]) | float(none) %}
          {{ (level + offset) | round(1) if level is not none and offset is not none else none }}
      - name: Music mic gain
        unique_id: audio_sensor_music_mic_gain
        default_entity_id: sensor.music_mic_gain
        icon: mdi:microphone-settings
        availability: >-
          [[ available('mic_gain') ]]
        state: >-
          {{ states([[ lookup('mic_gain') ]]) }}
        attributes:
          component: audio-sensor
      # `calibrated` once the apply script (or the home) turned the board's flag on, else `estimate`.
      - name: Music SPL calibration
        unique_id: audio_sensor_music_spl_calibration
        default_entity_id: sensor.music_spl_calibration
        icon: mdi:tune
        availability: >-
          [[ available('calibrated') ]]
        state: >-
          {{ 'calibrated' if is_state([[ lookup('calibrated') ]], 'on') else 'estimate' }}
        attributes:
          component: audio-sensor
          note: >-
            {{ states([[ lookup('note') ]]) }}
[%- endif %]
[%- if boards %]

  - binary_sensor:
      - name: Music sensor online
        unique_id: audio_sensor_music_sensor_online
        default_entity_id: binary_sensor.music_sensor_online
        device_class: connectivity
        state: >-
          {{ states([[ lookup('spectrum') ]]) not in ['unavailable', 'unknown'] }}
        attributes:
          component: audio-sensor
[%- endif %]
[%- if boards %]

  # The music source contract (SPEC-025): the board the select holds, and what it can do. An ability
  # is the board's capability, not whether data flows now, so these update on start, on a change of
  # the select and once a minute, never on the spectrum.
  - triggers:
      - trigger: homeassistant
        event: start
      - trigger: state
        entity_id: input_select.audio_sensor_music_source
      - trigger: time_pattern
        minutes: "/1"
    sensor:
      - name: Music source
        unique_id: audio_sensor_music_source
        default_entity_id: sensor.music_source
        icon: mdi:microphone-message
        state: >-
          {{ [[ lookup('area') ]] or 'none' }}
        attributes:
          component: audio-sensor
          interface: 1
          capabilities: >-
            [[ ability('spectrum') ]][[ ability('level') ]][[ ability('rate') ]][[ ability('calibration') ]][[ ability('gain') ]][% if strips %][[ ability('strip') ]][% endif %]{{ (['spectrum'] if spectrum else []) + (['level'] if level else []) + (['rate'] if rate else []) + (['calibration'] if calibration else []) + (['gain'] if gain else [])[% if strips %] + (['strip'] if strip else [])[% endif %] }}
    binary_sensor:
      - name: Music source spectrum
        unique_id: audio_sensor_music_source_spectrum
        default_entity_id: binary_sensor.music_source_spectrum
        state: >-
          [[ ability('spectrum') ]]{{ spectrum }}
        attributes:
          component: audio-sensor
      - name: Music source level
        unique_id: audio_sensor_music_source_level
        default_entity_id: binary_sensor.music_source_level
        state: >-
          [[ ability('level') ]]{{ level }}
        attributes:
          component: audio-sensor
      - name: Music source rate
        unique_id: audio_sensor_music_source_rate
        default_entity_id: binary_sensor.music_source_rate
        state: >-
          [[ ability('rate') ]]{{ rate }}
        attributes:
          component: audio-sensor
      - name: Music source calibration
        unique_id: audio_sensor_music_source_calibration
        default_entity_id: binary_sensor.music_source_calibration
        state: >-
          [[ ability('calibration') ]]{{ calibration }}
        attributes:
          component: audio-sensor
[%- if strips %]
      # SPEC-043: on while the selected board has a music strip (its light exists).
      - name: Music source strip
        unique_id: audio_sensor_music_source_strip
        default_entity_id: binary_sensor.music_source_strip
        state: >-
          [[ ability('strip') ]]{{ strip }}
        attributes:
          component: audio-sensor
          # The selected board's strip light, for a link to its device page (empty without a strip).
          light: >-
            {{ [[ lookup('strip_light') ]] }}
[%- endif %]
[%- endif %]
[%- if strips %]

  # SPEC-043: the selected board's music strip under a name that does not depend on the room, for a
  # consumer (the Ramka) that switches it or picks a style. Every other strip setting is on the
  # board's own device page.
  - light:
      - name: Music strip
        unique_id: audio_sensor_music_strip
        default_entity_id: light.music_strip
        icon: mdi:led-strip-variant
        availability: >-
          [[ available('strip_light') ]]
        state: >-
          {{ is_state([[ lookup('strip_light') ]], 'on') }}
        level: >-
          {{ state_attr([[ lookup('strip_light') ]], 'brightness') | int(0) }}
        effect_list: >-
          {{ state_attr([[ lookup('strip_light') ]], 'effect_list') or [] }}
        effect: >-
          {{ state_attr([[ lookup('strip_light') ]], 'effect') }}
        turn_on:
          - action: light.turn_on
            target:
              entity_id: >-
                {{ [[ lookup('strip_light') ]] }}
        turn_off:
          - action: light.turn_off
            target:
              entity_id: >-
                {{ [[ lookup('strip_light') ]] }}
        set_level:
          - action: light.turn_on
            target:
              entity_id: >-
                {{ [[ lookup('strip_light') ]] }}
            data:
              brightness: "{{ brightness }}"
        set_effect:
          - action: light.turn_on
            target:
              entity_id: >-
                {{ [[ lookup('strip_light') ]] }}
            data:
              effect: "{{ effect }}"
[%- endif %]
[%- if boards %]

# Applies the measurement to the board the select holds: the offset, the note, and the flag that says
# the offset is no longer an estimate. The same map as the aliases, so both agree on the board.
script:
  audio_sensor_apply_calibration:
    alias: Audio sensor apply calibration
    icon: mdi:check-decagram
    mode: single
    sequence:
      # Stop, writing nothing, unless the measurement is a number and the note has a state: an
      # unavailable helper must not set the offset to 0 or the note to "unavailable", nor turn the
      # calibrated flag on.
      - condition: template
        value_template: >-
          {{ states('input_number.audio_sensor_measured_offset') | is_number
             and states('input_text.audio_sensor_calibration_note') not in ['unavailable', 'unknown'] }}
      - variables:
          board: >-
            {{ {[% for b in ordered %][[ jstr(b.area) ]]: [[ jstr(b.prefix) ]], [% endfor %][[ jstr(none_option) ]]: ""}.get(states("input_select.audio_sensor_music_source"), [[ jstr(source.prefix) if source else '""' ]]) }}
      # No board selected (`—`, or no music board): nothing to apply the measurement to.
      - condition: template
        value_template: "{{ board != '' }}"
      - action: input_number.set_value
        target:
          entity_id: "{{ 'input_number.' ~ board ~ '_spl_offset' }}"
        data:
          value: "{{ states('input_number.audio_sensor_measured_offset') | float }}"
      - action: input_text.set_value
        target:
          entity_id: "{{ 'input_text.' ~ board ~ '_spl_note' }}"
        data:
          value: "{{ states('input_text.audio_sensor_calibration_note') }}"
      - action: input_boolean.turn_on
        target:
          entity_id: "{{ 'input_boolean.' ~ board ~ '_spl_calibrated' }}"
[%- endif %]
[%- if strips %]

  # SPEC-043: a palette for the selected board's strip, from anything that has one (the Ramka's
  # palette sync): writes the stops into its custom palette and selects it. Stops that are not 2 to
  # 5 #rrggbb colours, or a board without a strip, change nothing.
  audio_sensor_music_strip_palette:
    alias: Audio sensor music strip palette
    icon: mdi:palette
    mode: queued
    fields:
      stops:
        name: Stops
        description: 2 to 5 colours, each "#rrggbb".
        required: true
        example: ["#ff3000", "#ffb000", "#2050ff"]
        selector:
          object: {}
    sequence:
      - condition: template
        value_template: >-
          {% set ns = namespace(ok=stops is not string and stops is iterable and 2 <= stops | count <= 5) %}{% for s in stops if ns.ok %}{% set ns.ok = s is string and s | length == 7 and s[0] == '#' and (s[1:] | lower | list | reject('in', '0123456789abcdef') | list | count) == 0 %}{% endfor %}{{ ns.ok }}
      - variables:
          custom: >-
            {{ [[ lookup('strip_custom') ]] }}
          palette: >-
            {{ [[ lookup('strip_palette') ]] }}
      - condition: template
        value_template: >-
          {{ custom != '' and palette != '' and states(custom) not in ['unavailable', 'unknown'] }}
      - action: text.set_value
        target:
          entity_id: "{{ custom }}"
        data:
          value: "{{ stops | join(',') }}"
      - action: select.select_option
        target:
          entity_id: "{{ palette }}"
        data:
          option: custom
[%- endif %]
[%- if boards %]

# Forwards the spectrum rate to the board the music source select holds, the same map as the aliases.
# `fast` costs Wi-Fi airtime and the board's CPU, so it applies only while someone watches; 10 s after
# the last view leaves, the board goes back to normal (a quick page flip keeps it fast). Any change of
# a board's select re-applies the profile: its coming back online (an offline board cannot take the
# option), its own 60 min timeout from fast to normal while someone still watches, a change made on
# the board (HA owns the profile). Setting the option it already has changes no state, so no loop.
# HA's start re-applies too. A source change sets the board it leaves to normal.
automation:
  - id: audio_sensor_music_spectrum_rate
    alias: Audio sensor music spectrum rate
    description: Set the music board's Spectrum rate to the chosen profile, fast only while watching.
    mode: queued
    triggers:
      - trigger: state
        entity_id: input_select.audio_sensor_music_spectrum_rate
        id: choice
      - trigger: state
        entity_id: input_boolean.audio_sensor_music_watching
        to: "on"
        id: watching
      - trigger: state
        entity_id: input_boolean.audio_sensor_music_watching
        to: "off"
        for:
          seconds: 10
        id: watching
      - trigger: state
        entity_id: input_select.audio_sensor_music_source
        id: source
      - trigger: homeassistant
        event: start
        id: start
      - trigger: state
        entity_id:
[%- for b in ordered %]
          - [[ b.spectrum_rate ]]
[%- endfor %]
        not_to:
          - unavailable
          - unknown
        id: board
    actions:
      - variables:
          target: >-
            {{ [[ lookup('spectrum_rate') ]] }}
          previous: >-
            {{ [[ board_map('spectrum_rate') ]].get(trigger.from_state.state, [[ fallback('spectrum_rate') ]])
               if trigger.id == 'source' and trigger.from_state is not none else '' }}
          option: >-
            {% set choice = states('input_select.audio_sensor_music_spectrum_rate') %}
            {% if choice == 'fast' %}{{ 'fast' if is_state('input_boolean.audio_sensor_music_watching', 'on') else 'normal' }}
            {%- elif choice == 'eco' %}eco{% else %}normal{% endif %}
      - if:
          - condition: template
            value_template: >-
              {{ previous != '' and previous != target and states(previous) not in ['unavailable', 'unknown'] }}
        then:
          - action: select.select_option
            target:
              entity_id: "{{ previous }}"
            data:
              option: normal
      - condition: template
        value_template: >-
          {{ target != '' and states(target) not in ['unavailable', 'unknown'] }}
      - action: select.select_option
        target:
          entity_id: "{{ target }}"
        data:
          option: "{{ option }}"
[%- endif %]
[%- for b in follows %]

  # SPEC-043: the strip follows [[ b.strip.follow ]]. Restart mode: playing again during the delay
  # cancels the turn-off. Attribute changes (a player's position) do not trigger (`to: null`).
  - id: [[ b.prefix ]]_strip_follow_music
    alias: [[ jstr(b.area ~ ' strip follows the music') ]]
    description: Turn the music strip on while the music plays and off after the delay.
    mode: restart
    triggers:
      - trigger: state
        entity_id: [[ b.strip.follow ]]
        to: null
    conditions:
      - condition: state
        entity_id: input_boolean.[[ b.prefix ]]_strip_follow_music
        state: "on"
      - condition: template
        value_template: >-
          {{ trigger.to_state is not none and trigger.to_state.state not in ['unavailable', 'unknown'] }}
    actions:
      - variables:
          playing: >-
            {{ trigger.to_state.state == [[ b.strip.follow.startswith('media_player.') and "'playing'" or "'on'" ]] }}
          effect: >-
            {{ states('input_select.[[ b.prefix ]]_strip_follow_effect') }}
      - if:
          - condition: template
            value_template: "{{ playing }}"
        then:
          - action: light.turn_on
            target:
              entity_id: [[ b.strip_light ]]
            data: >-
              {{ {'effect': effect} if effect not in ['keep', 'unknown', 'unavailable', ''] else {} }}
        else:
          - delay:
              seconds: "{{ states('input_number.[[ b.prefix ]]_strip_follow_off_delay') | int(30) }}"
          - action: light.turn_off
            target:
              entity_id: [[ b.strip_light ]]
[%- endfor %]
[%- for b in ambients %]

  # SPEC-043: the strip's brightness follows [[ b.strip.ambient_light ]] while the strip is on: on a
  # change of more than 10 %, at most once every 10 s (single mode and the closing delay).
  - id: [[ b.prefix ]]_strip_ambient
    alias: [[ jstr(b.area ~ ' strip brightness follows the room') ]]
    description: Set the music strip's brightness from the room's light level.
    mode: single
    max_exceeded: silent
    triggers:
      - trigger: state
        entity_id: [[ b.strip.ambient_light ]]
        to: null
    conditions:
      - condition: state
        entity_id: input_boolean.[[ b.prefix ]]_strip_ambient
        state: "on"
      - condition: state
        entity_id: [[ b.strip_light ]]
        state: "on"
      - condition: template
        value_template: >-
          {% set new = trigger.to_state.state if trigger.to_state is not none else 'unavailable' %}
          {% set old = trigger.from_state.state if trigger.from_state is not none else 'unavailable' %}
          {% if new in ['unavailable', 'unknown'] or not new | is_number %}false
          {% elif old in ['unavailable', 'unknown'] or not old | is_number %}true
          {% else %}{{ (new | float - old | float) | abs > 0.1 * ([old | float, 1] | max) }}{% endif %}
    actions:
      - variables:
          brightness_pct: >-
            {% set lux = [states('[[ b.strip.ambient_light ]]') | float(0), 0.1] | max %}
            {# A fresh curve (every helper at its minimum, 0) means the home has not set one: the defaults. #}
            {% set fresh = states('input_number.[[ b.prefix ]]_strip_ambient_max_pct') | float(0) <= 0 %}
            {% set dark = [5 if fresh else states('input_number.[[ b.prefix ]]_strip_ambient_dark_lux') | float(5), 0.1] | max %}
            {% set bright = [300 if fresh else states('input_number.[[ b.prefix ]]_strip_ambient_bright_lux') | float(300), dark * 1.01] | max %}
            {% set low = 20 if fresh else states('input_number.[[ b.prefix ]]_strip_ambient_min_pct') | float(20) %}
            {% set high = 100 if fresh else states('input_number.[[ b.prefix ]]_strip_ambient_max_pct') | float(100) %}
            {% set t = ((lux | log(10)) - (dark | log(10))) / ((bright | log(10)) - (dark | log(10))) %}
            {% set t = [t, 0] | max %}{% set t = [t, 1] | min %}
            {{ (low + (high - low) * t) | round(0) }}
      - action: light.turn_on
        target:
          entity_id: [[ b.strip_light ]]
        data:
          brightness_pct: "{{ brightness_pct }}"
      - delay:
          seconds: 10
[%- endfor %]
