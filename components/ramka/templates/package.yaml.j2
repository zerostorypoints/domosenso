[#
  The Ramka's Home Assistant package: helpers, screen scripts, the ambient loop and the automations
  that move the tablet between off, ambient, controls and calendar. Rendered once per home (lang en)
  by tools/domosenso_render.py; double square brackets are the renderer's, {{ }} / {% %} stay for Home
  Assistant. Inputs: component.yaml `inputs:`.
#]
[%- set p = inputs.prefix -%]
[%- set name = inputs.name | default(p | replace('_', ' ') | title) -%]
[%- set notify = inputs.tablet_device.notify -%]
[%- set ts = inputs.tablet_device.sensors -%]
[%- set radar = inputs.radar -%]
[#- The photos (photo_dir, the folder sensor, input_text/image photo, shell/ramka_pick.py and
    ramka_index.py, the loop's photo stage) hang together and on nothing else of the Ramka, so they
    can leave it as a component of their own; without photo_dir none of them is rendered (0.2.0). -#]
[%- if inputs.photo_dir is defined -%]
[%- set photo_dir = inputs.photo_dir.rstrip('/') -%]
[%- if not photo_dir.startswith('/config/www/') -%][[ photo_dir_must_be_under_config_www ]][%- endif -%]
[%- set photo_url = (inputs.ha_url | default('http://127.0.0.1:8123')) ~ '/local/' ~ photo_dir[12:] -%]
[%- set folder_sensor = 'sensor.' ~ (photo_dir.split('/') | last | lower | replace('-', '_') | replace(' ', '_')) -%]
[%- set index_command = 'python3 /config/shell/ramka_index.py ' ~ photo_dir -%]
[%- set albums_command = 'python3 /config/shell/ramka_pick.py ' ~ photo_dir ~ ' --albums' -%]
[%- set index_description = 'Rebuild ' ~ photo_dir ~ '/index.json: at start, every 15 min, on a folder change.' -%]
[%- endif -%]
[#- The ambient pages this home has, in rotation order (0.2.0): climate, air, plants and photos only
    with their inputs (photos: photo_dir); status unless status_page is false (0.3.0). The input_select keeps all five options (FROZEN), so
    every step of the rotation goes to the next page that is there. -#]
[%- set pages = [] -%]
[%- for page in ['climate', 'air', 'plants', 'photos', 'status'] -%]
[%- if (inputs.status_page | default(true) if page == 'status' else inputs['photo_dir' if page == 'photos' else page] is defined) -%][%- set _ = pages.append(page) -%][%- endif -%]
[%- endfor -%]
[%- if not pages -%][[ fail('ramka: status_page: false leaves no ambient page; give climate, air, plants or photo_dir') ]][%- endif -%]
[#- The now-playing card's music visual (0.4.0): spectrum or level, chosen on the tablet. -#]
[%- set music_visual = inputs.music_visual | default(none) -%]
[%- if music_visual is not none and music_visual not in ['spectrum', 'level'] -%][[ fail("ramka: music_visual must be spectrum or level, not '" ~ music_visual ~ "'") ]][%- endif -%]
[%- set other_visual = 'level' if music_visual == 'spectrum' else 'spectrum' -%]
[#- ---- Live settings (0.4.0, SPEC-021) ----------------------------------------------------------
    Every behaviour setting is a helper with this home's default: the catalog's, then
    settings_defaults (General) and music_visual_options (Music) over it. The seed, the reset script
    and the templates' `| int()` / `| float()` fallbacks all read `d`, so they cannot disagree.
    Ranges are the helpers' own (0.3.0's for presence and display; the card's console for music). -#]
[%- set general = {'near_enabled': ('bool', true), 'off_delay_s': ('number', 300, 10, 1800), 'brightness_min': ('number', 16, 1, 255),
    'brightness_max': ('number', 204, 1, 255), 'near_cm': ('number', 100, 10, 400), 'near_s': ('number', 1, 1, 10),
    'controls_hold_s': ('number', 5, 1, 600), 'lux_max': ('number', 200, 20, 2000), 'theme_mode': ('choice', 'dark', ['dark', 'light'])} -%]
[%- set sd = inputs.settings_defaults | default({}) -%]
[%- if sd is not mapping -%][[ fail('ramka: settings_defaults must be a mapping') ]][%- endif -%]
[%- for key in sd if key not in general -%][[ fail("ramka: settings_defaults: unknown key '" ~ key ~ "'") ]][%- endfor -%]
[%- set d = {} -%]
[%- for key, spec in general.items() -%]
[%- set value = sd[key] if key in sd else spec[1] -%]
[%- if spec[0] == 'bool' and value is not boolean -%][[ fail('ramka: settings_defaults.' ~ key ~ ' must be true or false') ]][%- endif -%]
[%- if spec[0] == 'number' and (value is boolean or value is not number or value < spec[2] or value > spec[3]) -%][[ fail('ramka: settings_defaults.' ~ key ~ ' must be within ' ~ spec[2] ~ ' and ' ~ spec[3]) ]][%- endif -%]
[%- if spec[0] == 'choice' and value not in spec[2] -%][[ fail('ramka: settings_defaults.' ~ key ~ ' must be ' ~ spec[2] | join(' or ')) ]][%- endif -%]
[%- set _ = d.update({key: value}) -%]
[%- endfor -%]
[%- if d.brightness_min > d.brightness_max -%][[ fail('ramka: settings_defaults: brightness_min above brightness_max') ]][%- endif -%]
[#- The music visual's starting values. The flavour and palette lists are the card's registry
    (audio-sensor's cards/lib/flavours/index.js SPECTRUM and SCALAR, NAMED_PALETTES in
    cards/lib/config.js), literal here because a render cannot read another component's files;
    test_flavour_options_match_the_card_registry pins them. A palette of colour stops, which the card
    accepts, cannot be a select option and is refused. -#]
[%- set flavours = {'spectrum': ['still', 'swell', 'dune', 'veil', 'voices', 'halo', 'afterglow', 'bars'],
    'level': ['still', 'tide', 'centre', 'timeline', 'clocks', 'ripples', 'tint', 'bars']} -%]
[%- set palettes = ['zones', 'series', 'calm'] -%]
[%- macro within(key, value, lo, hi) -%][%- if value is boolean or value is not number or value < lo or value > hi -%][[ fail('ramka: music_visual_options.' ~ key ~ ' must be within ' ~ lo ~ ' and ' ~ hi) ]][%- endif -%][%- endmacro -%]
[#- The music EQ (the helpers, the look sensor and the dashboards below render from these two tables). Six
    ranges in dB, each -18...+12 (the card's range, spec 3.1); a key a preset leaves out is 0.
    `behind_speakers`, `half_match` and `fitted` are flat here: a home fills them with music_eq_presets, and
    the catalog carries no measured value. The WLED rows are derived from WLED-MM's frequency profiles
    (spec 3.3). -#]
[%- set eq_keys = ['sub', 'bass', 'low_mid', 'mid', 'presence', 'air'] -%]
[%- set eq_presets = {
    'flat': {'sub': 0, 'bass': 0, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0},
    'behind_speakers': {'sub': 0, 'bass': 0, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0},
    'half_match': {'sub': 0, 'bass': 0, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0},
    'wled_big_speakers': {'sub': -4, 'bass': -2, 'low_mid': -5, 'mid': 0, 'presence': 1, 'air': 2},
    'wled_big_speakers_ics': {'sub': -3, 'bass': -4, 'low_mid': -4, 'mid': 0, 'presence': 2, 'air': -1},
    'wled_pink': {'sub': -2, 'bass': 1, 'low_mid': 2, 'mid': 0, 'presence': 2, 'air': 4},
    'bass_light': {'sub': -8, 'bass': -6, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0},
    'voices': {'sub': -6, 'bass': -8, 'low_mid': -2, 'mid': 3, 'presence': 4, 'air': 0},
    'sparkle': {'sub': -3, 'bass': -3, 'low_mid': 0, 'mid': 0, 'presence': 3, 'air': 5},
    'fitted': {'sub': 0, 'bass': 0, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0}} -%]
[%- set meq = inputs.music_eq_presets | default({}) -%]
[%- if music_visual is not none and meq is not none -%]
[%- if meq is not mapping -%][[ fail('ramka: music_eq_presets must be a mapping') ]][%- endif -%]
[%- for id, own in meq.items() -%]
[%- if id not in ['behind_speakers', 'half_match', 'fitted'] -%][[ fail("ramka: music_eq_presets: unknown preset '" ~ id ~ "'") ]][%- endif -%]
[%- if own is not mapping -%][[ fail('ramka: music_eq_presets.' ~ id ~ ' must be a mapping') ]][%- endif -%]
[%- for key in own if key not in eq_keys -%][[ fail('ramka: music_eq_presets.' ~ id ~ ": unknown key '" ~ key ~ "'") ]][%- endfor -%]
[%- for key, value in own.items() -%]
[%- if value is boolean or value is not number or value < -18 or value > 12 -%][[ fail('ramka: music_eq_presets.' ~ id ~ '.' ~ key ~ ' must be within -18 and 12') ]][%- endif -%]
[%- set _ = eq_presets[id].update({key: value}) -%]
[%- endfor -%]
[%- endfor -%]
[%- endif -%]
[#- The response profiles' templates (spec 4.1); Custom is read from the helpers, so it is not here.
    On `fast` a frame arrives every 85 ms, so a rise under that acts as a jump. No profile carries a
    colour window: the neutral and hot levels are the user's helpers whichever profile is on. -#]
[%- set looks = {
    'behind_speakers': {'eq_id': 'fitted' if eq_presets.fitted.values() | select('!=', 0) | list else 'behind_speakers',
        'tilt': true, 'rise': 100, 'fall': 2, 'hold': 1.5},
    'lively': {'eq_id': 'wled_big_speakers_ics', 'tilt': false, 'rise': 50, 'fall': 0.3, 'hold': 0.5},
    'calm': {'eq_id': 'wled_big_speakers', 'tilt': true, 'rise': 80, 'fall': 4.2, 'hold': 2.0},
    'analyser': {'eq_id': 'flat', 'tilt': false, 'rise': 0, 'fall': 0.5, 'hold': 1.0}} -%]
[%- set mv = {} -%]
[%- if music_visual is not none -%]
[%- set mvo = inputs.music_visual_options | default({}) -%]
[%- if mvo is not mapping -%][[ fail('ramka: music_visual_options must be a mapping') ]][%- endif -%]
[%- for key in mvo if key not in ['spectrum', 'level', 'palette', 'rise', 'fall', 'line_width', 'tilt', 'fps'] -%][[ fail("ramka: music_visual_options: unknown key '" ~ key ~ "'") ]][%- endfor -%]
[%- set _ = mv.update({'music_visual': music_visual}) -%]
[%- set palette = mvo.palette | default('series') -%]
[%- if palette is not string or palette not in palettes -%][[ fail('ramka: music_visual_options.palette must be zones, series or calm') ]][%- endif -%]
[%- set _ = mv.update({'music_palette': palette}) -%]
[%- for kind, default_flavour in [('spectrum', 'dune'), ('level', 'centre')] -%]
[%- set own = mvo[kind] | default({}) -%]
[%- if own is not mapping -%][[ fail('ramka: music_visual_options.' ~ kind ~ ' must be a mapping') ]][%- endif -%]
[%- for key in own if key not in ['flavour', 'neutral', 'hot'] -%][[ fail('ramka: music_visual_options.' ~ kind ~ ": unknown key '" ~ key ~ "'") ]][%- endfor -%]
[%- set flavour = own.flavour | default(default_flavour) -%]
[%- if flavour not in flavours[kind] -%][[ fail('ramka: music_visual_options.' ~ kind ~ ".flavour '" ~ flavour ~ "' is not a " ~ kind ~ ' flavour') ]][%- endif -%]
[%- set neutral = own.neutral | default(30) -%]
[%- set hot = own.hot | default(70) -%]
[%- set _ = within(kind ~ '.neutral', neutral, 0, 130) ~ within(kind ~ '.hot', hot, 0, 130) -%]
[#- The card would reverse the palette and fall back to its defaults (orderColour). -#]
[%- if hot <= neutral -%][[ fail('ramka: music_visual_options.' ~ kind ~ ': hot must be above neutral') ]][%- endif -%]
[%- set _ = mv.update({'music_' ~ kind ~ '_flavour': flavour, 'music_' ~ kind ~ '_neutral_db': neutral, 'music_' ~ kind ~ '_hot_db': hot}) -%]
[%- endfor -%]
[%- for key, helper, default, lo, hi in [('rise', 'music_rise_ms', 200, 0, 2000), ('fall', 'music_fall_s', 4, 0, 30),
    ('line_width', 'music_line_width_px', 2.8, 0.5, 12), ('fps', 'music_fps', 30, 1, 60)] -%]
[%- set value = mvo[key] | default(default) -%]
[%- set _ = within(key, value, lo, hi) -%]
[%- set _ = mv.update({helper: value}) -%]
[%- endfor -%]
[%- set tilt = mvo.tilt | default(true) -%]
[%- if tilt is not boolean -%][[ fail('ramka: music_visual_options.tilt must be true or false') ]][%- endif -%]
[%- set _ = mv.update({'music_tilt': tilt}) -%]
[%- endif -%]
[#- Every setting: (domain, suffix, page, group, default). One page and one group each; the reset
    script sets them in this order. ambient_music is state the swipes flip, so it is on no page: the
    presence_display group (the first seed) and the global reset set it. -#]
[%- set settings = [('input_boolean', 'near_enabled', 'general', 'presence_display', d.near_enabled)] -%]
[%- for key in ['off_delay_s', 'brightness_min', 'brightness_max', 'near_cm', 'near_s', 'controls_hold_s', 'lux_max'] -%]
[%- set _ = settings.append(('input_number', key, 'general', 'presence_display', d[key])) -%]
[%- endfor -%]
[%- set _ = settings.append(('input_boolean', 'ambient_music', '', 'presence_display', true)) -%]
[%- set _ = settings.append(('input_select', 'theme_mode', 'general', 'pages', d.theme_mode)) -%]
[%- set _ = settings.append(('input_boolean', 'settings_advanced', 'general', 'pages', false)) -%]
[%- set views = ['climate', 'air', 'plants', 'photos', 'status', 'calendar', 'music'] -%]
[%- set reset_pages = ['general'] + views -%]
[%- for view in views -%][%- set _ = settings.append(('input_boolean', 'page_' ~ view, view, 'pages', true)) -%][%- endfor -%]
[%- for key, value in mv.items() -%]
[%- set _ = settings.append(('input_boolean' if key == 'music_tilt' else 'input_select' if key in ['music_visual', 'music_palette', 'music_spectrum_flavour', 'music_level_flavour'] else 'input_number', key, 'music', 'music_visual', value)) -%]
[%- endfor -%]
[#- The music look (spec 5): the entry on screen, and Custom's EQ and hold (its rise, fall, tilt and
    windows are the music_visual helpers above). A group of its own, seeded by its own numbers: a home
    that tuned its music window before the looks existed must still get a flat EQ and 1.5 s hold, not
    the sliders' minimum (-18 dB, 0 s). -#]
[%- set look_ids = ['custom'] + (looks | list) -%]
[%- if music_visual is not none -%]
[%- set _ = settings.append(('input_select', 'music_template', 'music', 'music_look', 'custom')) -%]
[%- set _ = settings.append(('input_select', 'music_eq', 'music', 'music_look', 'flat')) -%]
[%- for key in eq_keys -%][%- set _ = settings.append(('input_number', 'music_eq_' ~ key, 'music', 'music_look', 0)) -%][%- endfor -%]
[%- set _ = settings.append(('input_number', 'music_hold_s', 'music', 'music_look', 1.5)) -%]
[%- endif -%]
[#- The look sensor's tables, rendered here so Home Assistant only looks an entry up (it has no zip
    filter, and the catalog package carries no custom_templates file): the entry ids, the select's
    order, and per template its attributes in the card's `look` shape (spec 3.2). -#]
[%- set look_attrs = {} -%]
[%- for id, l in looks.items() -%]
[%- set _ = look_attrs.update({id: {'rise': l.rise, 'fall': l.fall, 'hold': l.hold, 'tilt': l.tilt, 'eq': eq_presets[l.eq_id]}}) -%]
[%- endfor -%]
[#- The Photos page (SPEC-021 amendment 1): the albums (top-level folders of photo_dir; none chosen
    is all), the photos per series and the time per photo; the defaults are 0.3.0's five photos of 10 s
    from all. The albums are not a helper (a list of any length): sensor.<prefix>_photo_albums keeps
    them, and the reset sets them with its event, the ('event', key, page, group, event data) entry:
    all albums, the ticked ones kept. -#]
[%- set photo_defaults = {'photo_count': 5, 'photo_s': 10} -%]
[#- The Plants page (SPEC-022): plants per page and seconds per page, read live by plants-card and
    by the plants stage of the ambient loop. -#]
[%- set plant_defaults_live = {'plants_per_page': 6, 'plants_page_s': 10} -%]
[%- if inputs.plants is defined -%]
[%- for key, value in plant_defaults_live.items() -%][%- set _ = settings.append(('input_number', key, 'plants', 'plants', value)) -%][%- endfor -%]
[%- endif -%]
[%- if inputs.photo_dir is defined -%]
[%- set _ = settings.append(('event', 'photo_albums', 'photos', 'photos', {'all': true})) -%]
[%- for key, value in photo_defaults.items() -%][%- set _ = settings.append(('input_number', key, 'photos', 'photos', value)) -%][%- endfor -%]
[%- endif -%]
[#- The Air page: a switch per configured reading, and the two limits of each, where its colour
    changes (good → raised → high; the score: good → fair → poor, higher is better). Defaults are the
    air-card's literal levels (templates/dashboard.lang.yaml.j2): (lower key, upper key, lower,
    upper, min, max, step, unit). -#]
[%- set air_limits = {'score': ('fair', 'poor', 80, 60, 0, 100, 1, ''), 'co2': ('raised', 'high', 800, 1200, 400, 5000, 50, 'ppm'),
    'pm2_5': ('raised', 'high', 15, 35, 1, 250, 1, 'µg/m³'), 'voc': ('raised', 'high', 150, 250, 1, 500, 1, ''),
    'nox': ('raised', 'high', 20, 150, 1, 500, 1, '')} -%]
[%- set air_readings = [] -%]
[%- for reading in air_limits if inputs.air is defined and inputs.air[reading] is defined -%][%- set _ = air_readings.append(reading) -%][%- endfor -%]
[%- for reading in air_readings -%][%- set _ = settings.append(('input_boolean', 'air_' ~ reading, 'air', 'air', true)) -%][%- endfor -%]
[%- for reading in air_readings -%]
[%- set l = air_limits[reading] -%]
[%- set _ = settings.append(('input_number', 'air_' ~ reading ~ '_' ~ l[0], 'air', 'air', l[2])) -%]
[%- set _ = settings.append(('input_number', 'air_' ~ reading ~ '_' ~ l[1], 'air', 'air', l[3])) -%]
[%- endfor -%]
[#- The Climate page's rooms (SPEC-021 amendments 2, 3): up to ten, each a label, a main reading and a
    supplementary one, picked on the settings page; the defaults are the first ten of inputs.climate,
    temperature and humidity. A list again, so sensor.<prefix>_climate_rooms keeps it, as the albums. -#]
[%- set climate_rooms = [] -%]
[%- for c in (inputs.climate | default([]))[:10] -%]
[%- set _ = climate_rooms.append({'label': c.label, 'main': c.temperature, 'extra': c.humidity | default('', true)}) -%]
[%- endfor -%]
[%- if inputs.climate is defined -%]
[%- set _ = settings.append(('event', 'climate_rooms', 'climate', 'climate', {'rooms': climate_rooms})) -%]
[%- endif -%]
[#- A select's options: its default first, then the rest in the given order, so a fresh helper is
    right before the seed runs. -#]
[%- macro options(default, all) -%]
[%- for option in [default] + (all | reject('equalto', default) | list) %]
      - [[ option ]]
[%- endfor -%]
[%- endmacro -%]
[#- The ambient pages whose switch is on, in rotation order; the first rendered page when none is
    (never empty). A Home Assistant expression, for sensor.<prefix>_ambient_pages. -#]
[%- set page_switches = [] -%]
[%- for page in pages -%][%- set _ = page_switches.append([page, 'input_boolean.' ~ p ~ '_page_' ~ page]) -%][%- endfor -%]
[%- macro switched_on() -%]{% set ns = namespace(on=[]) %}{% for page, switch in [[ page_switches | tojson ]] if is_state(switch, 'on') %}{% set ns.on = ns.on + [page] %}{% endfor %}[%- endmacro -%]
[#- The live list, read where the loop and the swipes step: the sensor's pages, or every rendered
    page while the sensor is not there yet. -#]
[%- set live = "(state_attr('sensor." ~ p ~ "_ambient_pages', 'pages') or " ~ (pages | tojson) ~ ")" -%]
[#- The page after `page` in the live list: the first live page later in the rendered order, else
    round to the first. A page switched off while it shows hands on to the next one that is on. -#]
[%- macro after(page) -%]{% set live = [[ live ]] %}{{ ((live | select('in', [[ pages[pages.index(page) + 1:] | tojson ]]) | list) or live) | first }}[%- endmacro -%]
[%- macro named(suffix) -%][%- set full = name ~ suffix -%][[ full | yaml ]][%- endmacro -%]
# Rendered from the Domosenso catalog, component ramka (templates/package.yaml.j2). Edit the
# inputs and render again rather than editing this file.
#
# The wall tablet (Home Assistant Companion app): the radar decides between off, ambient and
# controls, the ramka dashboard shows one section per state, and the Companion app's notification
# commands wake, dim and sleep the screen.

input_select:
  [[ p ]]_mode:
    name: [[ named(' mode') ]]
    icon: mdi:tablet-dashboard
    # "off" quoted: bare off is a YAML boolean. calendar: the calendar screen, from a button on
    # the controls; it ends like the controls do (leaving the zone, then the hold), a tap brings
    # the controls back.
    options: ["off", ambient, controls, calendar]
  [[ p ]]_ambient:
    name: [[ named(' ambient page') ]]
    icon: mdi:image-multiple
    # In the rotation's order: the swipes step through this list (select_next / select_previous).
    options: [climate, air, plants, photos, status]
  # The server's default theme, ramka-dark or ramka-light (automation [[ p ]]_theme_mode): every
  # browser on "Backend-selected" follows it, not only the tablet (0.4.0).
  [[ p ]]_theme_mode:
    name: [[ named(' theme mode') ]]
    icon: mdi:theme-light-dark
    options:[[ options(d.theme_mode, ['dark', 'light']) ]]
  [%- if music_visual %]
  # What the now-playing card draws in its wave strip (0.4.0): the room's music as audio-sensor's
  # spectrum or level, or the card's own classic wave. The input's choice comes first, so a fresh
  # helper starts there; no `initial:`, which would undo the choice at every restart. The settings
  # dashboard's Music page sets it, with the look below; the card reads every one of them live.
  [[ p ]]_music_visual:
    name: [[ named(' music visual') ]]
    icon: mdi:waveform
    options:
      - [[ music_visual ]]
      - [[ other_visual ]]
      - classic
  [[ p ]]_music_palette:
    name: [[ named(' music palette') ]]
    icon: mdi:palette
    options:[[ options(mv.music_palette, palettes) ]]
  [[ p ]]_music_spectrum_flavour:
    name: [[ named(' music spectrum flavour') ]]
    icon: mdi:equalizer
    options:[[ options(mv.music_spectrum_flavour, flavours.spectrum) ]]
  [[ p ]]_music_level_flavour:
    name: [[ named(' music level flavour') ]]
    icon: mdi:waveform
    options:[[ options(mv.music_level_flavour, flavours.level) ]]
  # The response profile (spec 4.1): Custom or a template; sensor.[[ p ]]_music_look follows it, and
  # the cards follow the sensor. Choosing a template never touches Custom's helpers.
  [[ p ]]_music_template:
    name: [[ named(' response profile') ]]
    icon: mdi:palette-swatch
    options:[[ options('custom', look_ids) ]]
  # An EQ preset to load into Custom's EQ (automation [[ p ]]_music_eq_load), whichever profile is on.
  [[ p ]]_music_eq:
    name: [[ named(' music EQ preset') ]]
    icon: mdi:tune-vertical-variant
    options:[[ options('flat', eq_presets | list) ]]
  [%- endif %]

# No `initial:` on any helper: HA would reset it to that value at every restart and throw away the
# tuning. The starting values come from the seed automation ([[ p ]]_settings_seed) on the first
# start, and from script.[[ p ]]_settings_reset later: near [[ d.near_cm ]] cm for [[ d.near_s ]] s,
# controls hold [[ d.controls_hold_s ]] s, off delay [[ d.off_delay_s ]] s, brightness [[ d.brightness_min ]] to [[ d.brightness_max ]] with lux_max [[ d.lux_max ]].
# Ambient has two faces while the media player plays: the now-playing card (default) or the
# home-info rotation. A swipe up on the controls picks the rotation, a swipe down the music, both
# leave to ambient; the player starting from silence sets it back to the music.
input_boolean:
  [[ p ]]_ambient_music:
    name: [[ named(' ambient shows the music') ]]
    icon: mdi:music-note
  # Controls on approach (the radar's near zone). Off: only a tap shows them; leaving the zone
  # still ends them. A tile on the controls panel flips it.
  [[ p ]]_near_enabled:
    name: [[ named(' controls on approach') ]]
    icon: mdi:hand-wave
  # The settings dashboard's Advanced parts show while this is on.
  [[ p ]]_settings_advanced:
    name: [[ named(' advanced settings') ]]
    icon: mdi:tune-variant
  # On once the seed has given every setting its starting value (automation [[ p ]]_settings_seed).
  [[ p ]]_settings_seeded:
    name: [[ named(' settings seeded') ]]
    icon: mdi:sprout
  # One switch per view: off takes the view out live, inside what the render configured (a view the
  # render left out stays out whatever its switch says). Every home has all seven.
  [%- for view in views %]
  [[ p ]]_page_[[ view ]]:
    name: [[ named(' page ' ~ view) ]]
    icon: mdi:eye
  [%- endfor %]
  [%- if music_visual %]
  [[ p ]]_music_tilt:
    name: [[ named(' music tilt') ]]
    icon: mdi:slope-uphill
  [%- endif %]
  # One per configured air reading: off leaves its tile out of the air page (air-card's `show:`).
  [%- for reading in air_readings %]
  [[ p ]]_air_[[ reading ]]:
    name: [[ named(' air ' ~ reading) ]]
    icon: mdi:eye
  [%- endfor %]

input_number:
  [[ p ]]_near_cm:
    name: [[ named(' near (cm)') ]]
    icon: mdi:hand-wave
    min: 10
    max: 400
    step: 10
    unit_of_measurement: cm
    mode: slider
  [[ p ]]_near_s:
    name: [[ named(' near hold (s)') ]]
    icon: mdi:timer-sand-complete
    min: 1
    max: 10
    step: 1
    unit_of_measurement: s
    mode: slider
  [[ p ]]_controls_hold_s:
    name: [[ named(' controls hold (s)') ]]
    icon: mdi:timer-outline
    min: 1
    max: 600
    step: 1
    unit_of_measurement: s
    mode: slider
  [[ p ]]_off_delay_s:
    name: [[ named(' off delay (s)') ]]
    icon: mdi:timer-sand
    min: 10
    max: 1800
    step: 10
    unit_of_measurement: s
    mode: slider
  # Auto brightness from the tablet's own light sensor (sensor.[[ ts ]]_light_sensor, lux, once a
  # minute): brightness_min in the dark, brightness_max at lux_max and above, logarithmic in
  # between (sensor.[[ p ]]_brightness_target below).
  [[ p ]]_brightness_min:
    name: [[ named(' brightness, dark') ]]
    icon: mdi:brightness-4
    min: 1
    max: 255
    step: 1
    mode: slider
  [[ p ]]_brightness_max:
    name: [[ named(' brightness, bright') ]]
    icon: mdi:brightness-7
    min: 1
    max: 255
    step: 1
    mode: slider
  [[ p ]]_lux_max:
    name: [[ named(' lux for full brightness') ]]
    icon: mdi:white-balance-sunny
    min: 20
    max: 2000
    step: 10
    unit_of_measurement: lx
    mode: slider
  [%- if music_visual %]
  # The music visual's look, bound to ambient-wave-card's options; ranges are the card's console
  # sliders (fps: the card's own check). The level is dB SPL too, so its pair takes the spectrum's range.
  [%- for key, label, icon, lo, hi, step, unit in [('rise_ms', ' music rise (ms)', 'mdi:arrow-up-bold', 0, 2000, 10, 'ms'),
      ('fall_s', ' music fall (s)', 'mdi:arrow-down-bold', 0, 30, 0.1, 's'),
      ('line_width_px', ' music line width (px)', 'mdi:format-line-weight', 0.5, 12, 0.1, 'px'),
      ('spectrum_neutral_db', ' music spectrum neutral (dB)', 'mdi:volume-low', 0, 130, 1, 'dB'),
      ('spectrum_hot_db', ' music spectrum hot (dB)', 'mdi:volume-high', 0, 130, 1, 'dB'),
      ('level_neutral_db', ' music level neutral (dB)', 'mdi:volume-low', 0, 130, 1, 'dB'),
      ('level_hot_db', ' music level hot (dB)', 'mdi:volume-high', 0, 130, 1, 'dB'),
      ('fps', ' music redraw rate (fps)', 'mdi:speedometer', 1, 60, 1, 'fps')] %]
  [[ p ]]_music_[[ key ]]:
    name: [[ named(label) ]]
    icon: [[ icon ]]
    min: [[ lo ]]
    max: [[ hi ]]
    step: [[ step ]]
    unit_of_measurement: [[ unit ]]
    mode: slider
  [%- endfor %]
  # Custom's EQ, one gain per range in the card's range order and limits (spec 3.1), and its hold.
  [%- for key in eq_keys %]
  [[ p ]]_music_eq_[[ key ]]:
    name: [[ named(' music EQ ' ~ key | replace('_', ' ') ~ ' (dB)') ]]
    icon: mdi:equalizer
    min: -18
    max: 12
    step: 0.5
    unit_of_measurement: dB
    mode: slider
  [%- endfor %]
  [[ p ]]_music_hold_s:
    name: [[ named(' music hold (s)') ]]
    icon: mdi:timer-sand
    min: 0
    max: 10
    step: 0.1
    unit_of_measurement: s
    mode: slider
  [%- endif %]
  [%- if inputs.photo_dir is defined %]
  [[ p ]]_photo_count:
    name: [[ named(' photos per series') ]]
    icon: mdi:image-multiple
    min: 1
    max: 20
    step: 1
    mode: slider
  [[ p ]]_photo_s:
    name: [[ named(' time per photo (s)') ]]
    icon: mdi:timer-outline
    min: 3
    max: 120
    step: 1
    unit_of_measurement: s
    mode: slider
  [%- endif %]
  [%- if inputs.plants is defined %]
  [[ p ]]_plants_per_page:
    name: [[ named(' plants per page') ]]
    icon: mdi:view-grid-outline
    min: 1
    max: 12
    step: 1
    mode: slider
  [[ p ]]_plants_page_s:
    name: [[ named(' time per plants page (s)') ]]
    icon: mdi:timer-outline
    min: 5
    max: 30
    step: 1
    unit_of_measurement: s
    mode: slider
  [%- endif %]
  # The air-card's limits, read live; an unusable state keeps the card's literal default.
  [%- for reading in air_readings %]
  [%- set l = air_limits[reading] %]
  [%- for which in [l[0], l[1]] %]
  [[ p ]]_air_[[ reading ]]_[[ which ]]:
    name: [[ named(' air ' ~ reading ~ ' ' ~ which) ]]
    icon: mdi:gauge
    min: [[ l[4] ]]
    max: [[ l[5] ]]
    step: [[ l[6] ]]
    [%- if l[7] %]
    unit_of_measurement: [[ l[7] | yaml ]]
    [%- endif %]
    mode: box
  [%- endfor %]
  [%- endfor %]

timer:
  [[ p ]]_controls:
    name: [[ named(' controls') ]]
    icon: mdi:timer-outline
    duration: "00:01:00"  # overridden on every start from controls_hold_s

# Reloads the tablet's page in place after a dashboard or card deploy: corner-taps-card's `reload`
# option watches it. Not command_webview, which starts a new hidden copy of the Companion app on
# every call (NEW_TASK | MULTIPLE_TASK, by design since 2024).
input_button:
  [[ p ]]_reload:
    name: [[ named(' reload page') ]]
    icon: mdi:reload

[%- if inputs.photo_dir is defined %]

input_text:
  # The photo on screen, "<folder>/<file>" under the photo folder.
  [[ p ]]_photo:
    name: [[ named(' photo') ]]
    icon: mdi:image
    max: 255
[%- endif %]
[%- if inputs.photo_dir is defined %]

# The photo folder: folders at any depth, the photo's own folder name is the caption. The folder
# platform names the entity after the last path component ([[ folder_sensor ]]); it only sees one
# level, so it is a change detector and a size readout, the picking is done by shell/ramka_pick.py.
# The path must be in homeassistant.allowlist_external_dirs.
sensor:
  - platform: folder
    folder: [[ photo_dir | yaml ]]
    filter: "*/*.jp*g"
[%- endif %]

shell_command:
  # The settings' About page (SPEC-023): what the home's Domosenso components use, read from Home
  # Assistant's own registries and files by shell/domosenso_discover.py (read-only), as JSON on
  # stdout for script.[[ p ]]_about_refresh.
  [[ p ]]_discover: python3 /config/shell/domosenso_discover.py /config
[%- if inputs.photo_dir is defined %]
  # shell/ramka_index.py writes index.json (event and EXIF date per photo) into the photo folder for
  # the photo card's caption; it runs at start and whenever the number of photos changes.
  [[ p ]]_index: [[ index_command | yaml ]]
  # The next series: one folder with photos drawn at random (any depth, inside the chosen albums
  # when there are any), `count` shuffled photos from it, as JSON on stdout for the loop's
  # response_variable. A templated command runs without a shell, its arguments split like a shell's:
  # each album is single-quoted, a quote in its name closed, escaped and reopened.
  [[ p ]]_pick: >-
    python3 /config/shell/ramka_pick.py [[ photo_dir ]] {{ count | default(5) }}{% for a in (albums if albums is defined and albums is not string and albums is iterable else []) %} '{{ a | replace("'", "'\\''") }}'{% endfor %}
  # The albums to choose from (sensor.[[ p ]]_photo_albums): the top-level folders that hold photos.
  [[ p ]]_albums: [[ albums_command | yaml ]]
[%- endif %]

# The About page's discovery is a snapshot for that page, not history: its state and its few kB of
# attributes stay out of the database (SPEC-023).
recorder:
  exclude:
    entities:
      - sensor.[[ p ]]_discovery
[%- if music_visual %]
      # The look follows input_select.[[ p ]]_music_template and the Custom helpers, all recorded.
      - sensor.[[ p ]]_music_look
[%- endif %]

template:
  - sensor:
      # What the screen should be at, from the room's light. The sensor's state is what the
      # auto-brightness automation and the screen_on script send.
      - name: [[ named(' brightness target') ]]
        unique_id: [[ p ]]_brightness_target
        default_entity_id: sensor.[[ p ]]_brightness_target
        icon: mdi:brightness-auto
        state_class: measurement
        availability: "{{ has_value('sensor.[[ ts ]]_light_sensor') }}"
        state: >-
          {% set lux = states('sensor.[[ ts ]]_light_sensor') | float(0) %}
          {% set lo = states('input_number.[[ p ]]_brightness_min') | float([[ d.brightness_min ]]) %}
          {% set hi = states('input_number.[[ p ]]_brightness_max') | float([[ d.brightness_max ]]) %}
          {% set lux_max = states('input_number.[[ p ]]_lux_max') | float([[ d.lux_max ]]) %}
          {% set k = [log(lux + 1, 10) / log(lux_max + 1, 10), 1] | min %}
          {{ (lo + (hi - lo) * k) | round(0) | int }}
      # The ambient pages in the rotation now: the rendered ones whose page switch is on, in
      # rotation order (rendered here: [[ pages | join(', ') ]]). Never empty: with every switch off
      # it lists the first page and all_off is true, which the settings page warns about. The loop
      # and the swipes step through `pages`.
      - name: [[ named(' ambient pages') ]]
        unique_id: [[ p ]]_ambient_pages
        default_entity_id: sensor.[[ p ]]_ambient_pages
        icon: mdi:view-carousel
        state: >-
          [[ switched_on() ]]{{ [ns.on | count, 1] | max }}
        attributes:
          component: ramka
          pages: >-
            [[ switched_on() ]]{{ ns.on if ns.on else [[ pages[:1] | tojson ]] }}
          all_off: >-
            [[ switched_on() ]]{{ ns.on | count == 0 }}
[%- if music_visual %]
[%- set select = "states('input_select." ~ p ~ "_music_template')" %]
[%- set m = 'input_number.' ~ p ~ '_music_' %]
[%- macro number(helper, default) %]states('[[ m ~ helper ]]') | float([[ default ]])[% endmacro %]
[%- set custom_eq = [] %]
[%- for key in eq_keys %][% set _ = custom_eq.append("'" ~ key ~ "': " ~ number('eq_' ~ key, 0)) %][% endfor %]
      # The response profile the cards bind (`look:`): the state is the entry on screen, a select state
      # that is no entry id is Custom (spec 8); the attributes are the card's `look` shape, a
      # template's from its row (rendered from the catalog's table and the home's EQ presets),
      # Custom's from its helpers, falling back to the seed's values while one is unavailable. No
      # colour window: the cards bind the neutral and hot helpers themselves.
      - name: [[ named(' music look') ]]
        unique_id: [[ p ]]_music_look
        default_entity_id: sensor.[[ p ]]_music_look
        icon: mdi:palette-swatch
        state: >-
          {% set id = [[ select ]] %}{{ id if id in [[ look_ids | tojson ]] else 'custom' }}
        attributes:
[%- for key, custom in [('rise', number('rise_ms', mv.music_rise_ms)), ('fall', number('fall_s', mv.music_fall_s)), ('hold', number('hold_s', 1.5)),
    ('tilt', ("not is_state('input_boolean." ~ p ~ "_music_tilt', 'off')") if mv.music_tilt else ("is_state('input_boolean." ~ p ~ "_music_tilt', 'on')")),
    ('eq', '{' ~ custom_eq | join(', ') ~ '}')] %]
[%- set table = {} %]
[%- for id, a in look_attrs.items() %][% set _ = table.update({id: a[key]}) %][% endfor %]
          [[ key ]]: >-
            {{ [[ table | tojson ]].get([[ select ]], [[ custom ]]) }}
[%- endfor %]
[%- endif %]
  - binary_sensor:
      # The media player playing, with track changes bridged. Between two tracks a player can
      # report playing → buffering → playing (or paused for buffering), each gap 0.5-3 s, and
      # every gap would take the now-playing card off the screen and flash the rotation. The delay
      # sits here and not on the music view, so a swipe up still leaves the music at once. It is
      # fixed: HA renders a templated delay_off after the state, with the old value, so after
      # standby or a pause the music view stays the same 5 s.
      - name: [[ named(' media playing') ]]
        unique_id: [[ p ]]_media_playing
        default_entity_id: binary_sensor.[[ p ]]_media_playing
        icon: mdi:play-circle
        delay_off:
          seconds: 5
        state: "{{ is_state('[[ inputs.media_player ]]', 'playing') }}"
      # Ambient shows the now-playing card: the player plays, the music face is chosen and the
      # music view is switched on (input_boolean.[[ p ]]_page_music; off, ambient keeps the
      # rotation). Every view condition and the loop's start/stop read this one sensor. The marker
      # lets every Ramka's music_watching automation see the others' music views.
      - name: [[ named(' music view') ]]
        unique_id: [[ p ]]_music_view
        default_entity_id: binary_sensor.[[ p ]]_music_view
        icon: mdi:album
        state: >-
          {{ is_state('binary_sensor.[[ p ]]_media_playing', 'on')
             and is_state('input_boolean.[[ p ]]_ambient_music', 'on')
             and is_state('input_boolean.[[ p ]]_page_music', 'on') }}
        attributes:
          component: ramka
      # "Someone at the tablet", debounced. An LD2410's moving-target flag flickers off for a
      # second or two every few seconds even with a person standing at the screen, and the
      # detection distance jumps to a farther object or to 0 in those gaps, so a trigger that
      # needs the raw reading to hold for 3 s almost never fires. This sensor is on while the
      # radar sees a target whose distance is within near_cm, and delay_off keeps it on across
      # gaps shorter than two seconds; the near automation then asks for it to be on for near_s.
      # No still branch: within 1.5 m (gates 0-1) the module reports no still targets at all.
      - name: [[ named(' near') ]]
        unique_id: [[ p ]]_near
        default_entity_id: binary_sensor.[[ p ]]_near
        icon: mdi:hand-wave
        device_class: occupancy
        delay_off:
          seconds: 2
        state: >-
          {% set d = states('[[ radar.distance ]]') | float(0) %}
          {{ is_state('[[ radar.presence ]]', 'on')
             and 0 < d <= states('input_number.[[ p ]]_near_cm') | float([[ d.near_cm ]]) }}
[%- if inputs.photo_dir is defined %]
  # The photo named by input_text.[[ p ]]_photo, so a card can show a file that changes. HA
  # fetches it from itself; /local/ needs no token. Each path segment is URL-encoded on its own
  # (folder and file names can have spaces).
  - image:
      - name: [[ named(' photo') ]]
        unique_id: [[ p ]]_photo
        default_entity_id: image.[[ p ]]_photo
        url: >-
          [[ photo_url ]]/{{ states('input_text.[[ p ]]_photo').split('/') | map('urlencode') | join('/') }}
        availability: "{{ states('input_text.[[ p ]]_photo') not in ['', 'unknown', 'unavailable'] }}"
  # The photo albums (SPEC-021 amendments 1 and 2): `available`, the top-level folders with photos
  # (from the photo index), `chosen`, the ticked ones, and `all`: every album, the ticks kept for
  # later (the settings page's album card; none chosen is all too). The state is how many are
  # chosen. A list of any length, which no helper holds; a trigger-based entity restores its
  # attributes after a restart. Event [[ p ]]_photo_albums sets any of the keys and keeps the rest;
  # without `all` ever set (0.4.0's sensor), all is none chosen.
  - triggers:
      - trigger: event
        event_type: [[ p ]]_photo_albums
    sensor:
      - name: [[ named(' photo albums') ]]
        unique_id: [[ p ]]_photo_albums
        default_entity_id: sensor.[[ p ]]_photo_albums
        icon: mdi:folder-image
        state: >-
          {{ (trigger.event.data.chosen if trigger.event.data.chosen is defined else this.attributes.chosen | default([])) | count }}
        attributes:
          available: >-
            {{ trigger.event.data.available if trigger.event.data.available is defined else this.attributes.available | default([]) }}
          chosen: >-
            {{ trigger.event.data.chosen if trigger.event.data.chosen is defined else this.attributes.chosen | default([]) }}
          all: >-
            {% set chosen = trigger.event.data.chosen if trigger.event.data.chosen is defined else this.attributes.chosen | default([]) %}
            {{ trigger.event.data.all if trigger.event.data.all is defined else this.attributes.all if this.attributes.all is defined else chosen | count == 0 }}
[%- endif %]
[%- if inputs.climate is defined %]
  # The Climate page's rooms (SPEC-021 amendments 2, 3): `rooms`, up to ten of {label, main, extra},
  # entity ids, extra may be empty; the room tiles and the 7-day charts follow it, in its order
  # (colour n is room n). Set by the settings page's climate card through event [[ p ]]_climate_rooms;
  # the seed gives it inputs.climate's first ten. Before that the cards show inputs.climate.
  - triggers:
      - trigger: event
        event_type: [[ p ]]_climate_rooms
    sensor:
      - name: [[ named(' climate rooms') ]]
        unique_id: [[ p ]]_climate_rooms
        default_entity_id: sensor.[[ p ]]_climate_rooms
        icon: mdi:home-thermometer
        state: "{{ trigger.event.data.rooms | default([]) | count }}"
        attributes:
          rooms: "{{ trigger.event.data.rooms | default([]) }}"
[%- endif %]
  # The About page's discovery (SPEC-023): the time of the last refresh, and as attributes what
  # shell/domosenso_discover.py found (components, the entities each uses, their integrations, the
  # home's declared links). Set by script.[[ p ]]_about_refresh through event [[ p ]]_discovery;
  # a trigger-based entity keeps its last value over a restart. No device_class: the page shows the
  # date itself, and the recorder leaves the entity out (below).
  - triggers:
      - trigger: event
        event_type: [[ p ]]_discovery
    sensor:
      - name: [[ named(' discovery') ]]
        unique_id: [[ p ]]_discovery
        default_entity_id: sensor.[[ p ]]_discovery
        icon: mdi:magnify-scan
        state: "{{ trigger.event.data.refreshed }}"
        attributes:
          component: ramka
          ha_version: "{{ trigger.event.data.ha_version | default('') }}"
          found: "{{ trigger.event.data.found | default([]) }}"
          uses: "{{ trigger.event.data.uses | default({}) }}"
          integrations: "{{ trigger.event.data.integrations | default({}) }}"
          declared_links: "{{ trigger.event.data.declared_links | default([]) }}"
          links: "{{ trigger.event.data.links | default({}) }}"

# Screen scripts. Each step is one Companion notification command
# (https://companion.home-assistant.io/docs/notifications/notification-commands). Both scripts
# return quietly while the tablet is not registered yet (no battery sensor → no device).
script:
  [[ p ]]_screen_on:
    alias: [[ named(' screen on') ]]
    icon: mdi:tablet
    mode: single
    sequence:
      - condition: template
        value_template: "{{ states.sensor.[[ ts ]]_battery_level is not none }}"
      # The screen stays on through Android's own screen timeout, 24 h (never, in practice, yet
      # bounded if a screen_off gets lost); screen_off puts it back to 15 s. Not through the
      # Companion app's Keep screen on (command_screen_on keep_screen_on): the app applies that
      # preference to the window only when the page resumes, so a screen woken with it on never
      # slept again.
      - action: [[ notify ]]
        data:
          message: command_screen_off_timeout
          data:
            command: 86400000
      # The wake itself: a 30 s full wake lock that leaves the screen on when released. Any
      # command other than keep_screen_on keeps the app's Keep screen on preference off.
      - action: [[ notify ]]
        data:
          message: command_screen_on
          data:
            command: release
      - action: [[ notify ]]
        data:
          message: command_auto_screen_brightness
          data:
            command: turn_off
      - action: [[ notify ]]
        data:
          message: command_screen_brightness_level
          data:
            command: "{{ states('sensor.[[ p ]]_brightness_target') | int(120) }}"
      # Back on top, but only when the app is not on top any more. "foreground" is the app on a
      # lit screen, "top_sleeping" the same app behind a sleeping screen; in both the screen simply
      # lights up on whatever was shown. Anything else (cached, background, gone) means Android
      # pushed the app away. command_launch_app sends the app's launcher intent, which brings the
      # existing task forward with its page as it was, as a tap on the icon does; if Android
      # killed the app, it starts on the tablet user's default dashboard. Not command_webview,
      # which opens a new hidden copy of the app on every call and reloads the page.
      - if:
          - condition: not
            conditions:
              - condition: state
                entity_id: sensor.[[ ts ]]_app_importance
                state:
                  - foreground
                  - top_sleeping
        then:
          - action: [[ notify ]]
            data:
              message: command_launch_app
              data:
                package_name: io.homeassistant.companion.android
  # Show the controls, or keep them up: the near automation and a tap on the screen (the
  # corner-taps card's tap option) both land here. The hold timer counts from leaving the near
  # zone, not from the last trigger, so while someone is within near_cm there is no timer at all;
  # a tap with "near" off (a flicker, or a reach from farther away) starts it, so the controls
  # never stay up on their own.
  [[ p ]]_show_controls:
    alias: [[ named(' show controls') ]]
    icon: mdi:gesture-tap
    mode: queued
    sequence:
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: controls
      - if:
          - condition: state
            entity_id: binary_sensor.[[ p ]]_near
            state: "on"
        then:
          - action: timer.cancel
            target:
              entity_id: timer.[[ p ]]_controls
        else:
          - action: timer.start
            target:
              entity_id: timer.[[ p ]]_controls
            data:
              duration: "{{ states('input_number.[[ p ]]_controls_hold_s') | int([[ d.controls_hold_s ]]) }}"
  # Swipes on the rotation (ambient, music view off): up = the next page, down = the previous,
  # round the pages; the loop restarts and the cycle begins on that page with its full time.
  [[ p ]]_ambient_next:
    alias: [[ named(' ambient next page') ]]
    icon: mdi:chevron-up
    mode: single
    sequence:
      # The live list (sensor.[[ p ]]_ambient_pages): the pages this home has whose switch is on.
      # From a page switched off, the next one on after it.
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_ambient
        data:
          option: >-
            {% set live = [[ live ]] %}{% set order = [[ pages | tojson ]] %}{% set here = states('input_select.[[ p ]]_ambient') %}
            {% if here in order %}{{ ((live | select('in', order[order.index(here) + 1:]) | list) or live) | first }}{% else %}{{ live | first }}{% endif %}
      - action: script.turn_on
        target:
          entity_id: script.[[ p ]]_ambient_loop
  [[ p ]]_ambient_prev:
    alias: [[ named(' ambient previous page') ]]
    icon: mdi:chevron-down
    mode: single
    sequence:
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_ambient
        data:
          option: >-
            {% set live = [[ live ]] %}{% set order = [[ pages | tojson ]] %}{% set here = states('input_select.[[ p ]]_ambient') %}
            {% if here in order %}{{ ((live | select('in', order[:order.index(here)]) | list) or live) | last }}{% else %}{{ live | first }}{% endif %}
      - action: script.turn_on
        target:
          entity_id: script.[[ p ]]_ambient_loop
  # The calendar screen, from the calendar button on the controls. Same hold rules as the
  # controls: no timer while someone is within near_cm, controls_hold_s after leaving. Not while the
  # calendar view is switched off (its buttons hide then too).
  [[ p ]]_show_calendar:
    alias: [[ named(' show calendar') ]]
    icon: mdi:calendar-month
    mode: single
    sequence:
      - condition: state
        entity_id: input_boolean.[[ p ]]_page_calendar
        state: "on"
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: calendar
      - if:
          - condition: state
            entity_id: binary_sensor.[[ p ]]_near
            state: "on"
        then:
          - action: timer.cancel
            target:
              entity_id: timer.[[ p ]]_controls
        else:
          - action: timer.start
            target:
              entity_id: timer.[[ p ]]_controls
            data:
              duration: "{{ states('input_number.[[ p ]]_controls_hold_s') | int([[ d.controls_hold_s ]]) }}"

  # Swipes on the controls (corner-taps card, swipe option), both leave to ambient at once:
  # up = the home-info rotation from the climate page, down = the music (the rotation anyway while
  # the player is silent). Standing there changes nothing more; the next approach or tap brings
  # the controls back.
  [[ p ]]_swipe_up:
    alias: [[ named(' swipe up') ]]
    icon: mdi:gesture-swipe-up
    mode: single
    sequence:
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.[[ p ]]_ambient_music
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_ambient
        data:
          option: >-
            {{ [[ live ]] | first }}
      - action: timer.cancel
        target:
          entity_id: timer.[[ p ]]_controls
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: ambient
  [[ p ]]_swipe_down:
    alias: [[ named(' swipe down') ]]
    icon: mdi:gesture-swipe-down
    mode: single
    sequence:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.[[ p ]]_ambient_music
      - action: timer.cancel
        target:
          entity_id: timer.[[ p ]]_controls
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: ambient
  [[ p ]]_screen_off:
    alias: [[ named(' screen off') ]]
    icon: mdi:tablet-off
    mode: single
    sequence:
      - condition: template
        value_template: "{{ states.sensor.[[ ts ]]_battery_level is not none }}"
      # command_screen_on with any value other than keep_screen_on keeps Keep screen on off (the
      # screen is already on here, so the "on" part is a no-op). What sleeps the screen is the
      # 15 s timeout below, counted from this command's wake lock.
      - action: [[ notify ]]
        data:
          message: command_screen_on
          data:
            command: release
      - action: [[ notify ]]
        data:
          message: command_screen_off_timeout
          data:
            command: 15000
      - action: [[ notify ]]
        data:
          message: command_screen_brightness_level
          data:
            command: 0

  # The ambient loop (see automation [[ p ]]_ambient_start). Each pass: climate page 30 s, air
  # quality 15 s, plants 20 s, a series of photos from one folder drawn at random (the Photos
  # page's count and time, five of 10 s by default), the status page 15 s: 130 s in all by default. With an empty folder the photos are skipped (an empty for_each runs
  # nothing). The while-condition ends the loop by itself if the mode or the player changed and
  # the stop automation did not get to it first.
  [[ p ]]_ambient_loop:
    alias: [[ named(' ambient loop') ]]
    icon: mdi:play-box-multiple
    mode: restart
    sequence:
      - repeat:
          while:
            - condition: state
              entity_id: input_select.[[ p ]]_mode
              state: ambient
            # The music view is off: the player is silent, or the swipe chose the home info.
            - condition: state
              entity_id: binary_sensor.[[ p ]]_music_view
              state: "off"
          # Five stages, each guarded by the page the frame is on, so a pass picks up wherever
          # the page already is: a swipe (scripts ambient_next/prev) sets the page and restarts
          # this script, and the cycle begins there with that page's full time. Left alone it runs
          # climate → air → plants → photos → status → climate.
          sequence:
            # The live list: the pages this home has whose switch is on. A page not in it (switched
            # off, or one the helper stands on after a restart) goes to the list's first, or no
            # stage below would match. A switch turned off while its page shows takes effect at the
            # end of that stage: each stage hands on to the next page that is on.
            # Pages this home has: [[ pages | join(', ') ]].
            - if:
                - condition: template
                  value_template: >-
                    {{ states('input_select.[[ p ]]_ambient') not in [[ live ]] }}
              then:
                - action: input_select.select_option
                  target:
                    entity_id: input_select.[[ p ]]_ambient
                  data:
                    option: >-
                      {{ [[ live ]] | first }}
[%- if 'climate' in pages %]
            # 1. Climate, 30 s.
            - if:
                - condition: state
                  entity_id: input_select.[[ p ]]_ambient
                  state: climate
              then:
                - delay:
                    seconds: 30
                - action: input_select.select_option
                  target:
                    entity_id: input_select.[[ p ]]_ambient
                  data:
                    option: >-
                      [[ after('climate') ]]
[%- endif %]
[%- if 'air' in pages %]
            # 2. Air quality, 15 s: a handful of numbers, read at a glance.
            - if:
                - condition: state
                  entity_id: input_select.[[ p ]]_ambient
                  state: air
              then:
                - delay:
                    seconds: 15
                - action: input_select.select_option
                  target:
                    entity_id: input_select.[[ p ]]_ambient
                  data:
                    option: >-
                      [[ after('air') ]]
[%- endif %]
[%- if 'plants' in pages %]
            # 3. Plants: the ones that need something first, at most two pages of plants_page_s
            #    (plants-card turns them and continues on the next pass); no plants found: 1 s, so a
            #    rotation of plants alone never runs without a pause.
            - if:
                - condition: state
                  entity_id: input_select.[[ p ]]_ambient
                  state: plants
              then:
                - delay:
                    seconds: >-
[%- if inputs.plants is string %]
                      {% set n = states.plant | selectattr('attributes.domosenso_plant', 'defined') | list | count %}
[%- else %]
                      {% set n = [[ inputs.plants | length ]] %}
[%- endif %]
                      {% set per = states('input_number.[[ p ]]_plants_per_page') | int(6) %}
                      {% set per = per if per > 0 else 6 %}
                      {{ [([((n + per - 1) // per), 2] | min) * (states('input_number.[[ p ]]_plants_page_s') | int(10)), 1] | max }}
                - action: input_select.select_option
                  target:
                    entity_id: input_select.[[ p ]]_ambient
                  data:
                    option: >-
                      [[ after('plants') ]]
[%- endif %]
[%- if 'photos' in pages %]
            # 4. Photos: from the plants page, or straight in when the page already is photos.
            #    shell/ramka_pick.py: one folder that holds photos, at any depth (inside the chosen
            #    album), drawn with equal chances, then up to `count` different photos from it. An
            #    empty folder tree gives an empty list: the photos are skipped after one slot.
            - if:
                - condition: state
                  entity_id: input_select.[[ p ]]_ambient
                  state: photos
              then:
                - action: shell_command.[[ p ]]_pick
                  data:
                    count: "{{ states('input_number.[[ p ]]_photo_count') | int([[ photo_defaults.photo_count ]]) }}"
                    # All albums ticked, none chosen, or the sensor not there yet: every album.
                    albums: >-
                      {{ [] if state_attr('sensor.[[ p ]]_photo_albums', 'all') else state_attr('sensor.[[ p ]]_photo_albums', 'chosen') or [] }}
                  response_variable: pick
                - variables:
                    # The JSON is the last line of stdout; anything the script printed before it
                    # is ignored.
                    picks: >-
                      {% set lines = (pick.stdout | default('')).strip().splitlines() %}
                      {{ (lines | last | from_json).photos if lines else [] }}
                - repeat:
                    for_each: "{{ picks }}"
                    sequence:
                      - action: input_text.set_value
                        target:
                          entity_id: input_text.[[ p ]]_photo
                        data:
                          value: "{{ repeat.item }}"
                      - action: input_select.select_option
                        target:
                          entity_id: input_select.[[ p ]]_ambient
                        data:
                          option: photos
                      - delay:
                          seconds: "{{ states('input_number.[[ p ]]_photo_s') | int([[ photo_defaults.photo_s ]]) }}"
                # An empty pick (no photos, or the folder not mounted) still takes one slot: with
                # photos the only page switched on, the next page is photos again, and the loop
                # would otherwise call the pick without a pause.
                - if:
                    - condition: template
                      value_template: "{{ picks | count == 0 }}"
                  then:
                    - delay:
                        seconds: "{{ states('input_number.[[ p ]]_photo_s') | int([[ photo_defaults.photo_s ]]) }}"
                - action: input_select.select_option
                  target:
                    entity_id: input_select.[[ p ]]_ambient
                  data:
                    option: >-
                      [[ after('photos') ]]
[%- endif %]
[%- if 'status' in pages %]
            # 5. Status, 15 s, then round to the climate page.
            - if:
                - condition: state
                  entity_id: input_select.[[ p ]]_ambient
                  state: status
              then:
                - delay:
                    seconds: 15
                - action: input_select.select_option
                  target:
                    entity_id: input_select.[[ p ]]_ambient
                  data:
                    option: >-
                      [[ after('status') ]]
[%- endif %]

[%- if inputs.photo_dir is defined %]
  # The albums the photo series come from. Called by the settings page's album card, always with
  # both fields: all_albums keeps the ticks for when it is turned off again. Not `all`, a name
  # Jinja code may know as a global.
  [[ p ]]_photo_albums_set:
    alias: [[ named(' photo albums set') ]]
    icon: mdi:folder-image
    mode: queued
    fields:
      chosen:
        name: Albums
        description: Top-level folders of the photo folder, a list; none for all.
        # No selector: HA 2026.9.2 refused `object: {}` here and disabled the script.
        example: '["2025", "2026"]'
      all_albums:
        name: All albums
        description: Every album, whatever is chosen; absent, all when none is chosen.
        # No selector either: 2026.9.2 refused `boolean: {}` too ("Only one type can be specified").
        example: "true"
    sequence:
      - variables:
          picked: "{{ chosen if chosen is defined and chosen is not string and chosen is iterable else [] }}"
      - event: [[ p ]]_photo_albums
        event_data:
          chosen: "{{ picked }}"
          all: "{{ all_albums if all_albums is defined else picked | count == 0 }}"
[%- endif %]
[%- if inputs.climate is defined %]

  # The Climate page's rooms, up to ten {label, main, extra}; a room without its main reading is
  # dropped. Called by the settings page's climate card.
  [[ p ]]_climate_rooms_set:
    alias: [[ named(' climate rooms set') ]]
    icon: mdi:home-thermometer
    mode: queued
    fields:
      rooms:
        name: Rooms
        description: Up to ten of {label, main, extra}, entity ids; extra may be empty.
        # No selector, as the albums' script: object: {} is refused.
        example: '[{"label": "Kitchen", "main": "sensor.kitchen_temperature", "extra": "sensor.kitchen_humidity"}]'
    sequence:
      - event: [[ p ]]_climate_rooms
        event_data:
          rooms: >-
            {% set given = rooms if rooms is defined and rooms is not string and rooms is iterable else [] %}
            {% set kept = namespace(rooms=[]) %}
            {% for r in given if r is mapping and (r.main | default('') | string).startswith('sensor.') %}
            {% set kept.rooms = kept.rooms + [{'label': r.label | default('') | string, 'main': r.main, 'extra': r.extra | default('') | string}] %}
            {% endfor %}
            {{ kept.rooms[:10] }}
[%- endif %]

  # The About page's Refresh (SPEC-023): runs the discovery, publishes it to sensor.[[ p ]]_discovery
  # and asks the HACS update entities it names to check for a newer version. Also at start and
  # nightly (automation [[ p ]]_about_discover).
  [[ p ]]_about_refresh:
    alias: [[ named(' about refresh') ]]
    icon: mdi:refresh
    mode: single
    sequence:
      - action: shell_command.[[ p ]]_discover
        response_variable: run
      - if: "{{ run.returncode != 0 }}"
        then:
          - stop: "{{ 'discovery failed: ' ~ (run.stderr | default('') | string)[-300:] }}"
            error: true
      - variables:
          found: "{{ run.stdout | from_json }}"
          updates: "{{ found.integrations.values() | map(attribute='update_entity') | select | list }}"
      - event: [[ p ]]_discovery
        event_data:
          refreshed: "{{ found.refreshed }}"
          ha_version: "{{ found.ha_version }}"
          found: "{{ found.found }}"
          uses: "{{ found.uses }}"
          integrations: "{{ found.integrations }}"
          declared_links: "{{ found.declared_links }}"
          links: "{{ found.links | default({}) }}"
      - if: "{{ updates | count > 0 }}"
        then:
          - action: homeassistant.update_entity
            target:
              entity_id: "{{ updates }}"

[%- if music_visual %]

  # "Copy to custom" (spec 5): the entry on screen becomes Custom's starting point. It copies the
  # look sensor's attributes, which are what the cards show, into Custom's 10 helpers, then selects
  # Custom. With the sensor unavailable or an attribute missing it writes nothing and says so.
  [[ p ]]_music_copy_to_custom:
    alias: [[ named(' music copy to custom') ]]
    icon: mdi:content-copy
    mode: single
    sequence:
      - variables:
[%- for key in ['rise', 'fall', 'hold', 'tilt', 'eq'] %]
          [[ key ]]: "{{ state_attr('sensor.[[ p ]]_music_look', '[[ key ]]') }}"
[%- endfor %]
      - if:
          - condition: template
            value_template: >-
              {{ not (rise is number and fall is number and hold is number and tilt is boolean
                      and eq is mapping and [[ eq_keys | tojson ]] | reject('in', eq) | list | count == 0) }}
        then:
          - action: system_log.write
            data:
              level: warning
              logger: [[ p ]].music_look
              message: sensor.[[ p ]]_music_look has no complete look, so Custom is unchanged
          - stop: The look sensor has no complete look
[%- for key in eq_keys %]
      - action: input_number.set_value
        target:
          entity_id: input_number.[[ p ]]_music_eq_[[ key ]]
        data:
          value: "{{ eq.[[ key ]] }}"
[%- endfor %]
[%- for helper, value in [('hold_s', 'hold'), ('rise_ms', 'rise'), ('fall_s', 'fall')] %]
      - action: input_number.set_value
        target:
          entity_id: input_number.[[ p ]]_music_[[ helper ]]
        data:
          value: "{{ [[ value ]] }}"
[%- endfor %]
      - action: "input_boolean.turn_{{ 'on' if tilt else 'off' }}"
        target:
          entity_id: input_boolean.[[ p ]]_music_tilt
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_music_template
        data:
          option: custom

  # Loads an EQ preset's six gains into Custom's EQ; called by automation [[ p ]]_music_eq_load and,
  # without a preset, by the settings page's Load button, which loads the EQ select's preset (the
  # same preset chosen again changes no state, so the automation cannot re-apply it). The presets
  # are rendered in (the catalog's, the home's music_eq_presets over its own three). It writes Custom
  # whichever profile is on: Custom's sliders are always editable. An id that is no preset writes
  # nothing and says so.
  [[ p ]]_music_load_eq:
    alias: [[ named(' music load EQ preset') ]]
    icon: mdi:tune-vertical-variant
    mode: restart
    fields:
      preset:
        name: Preset
        description: An EQ preset id, one of input_select.[[ p ]]_music_eq's options; without it, the select's state.
        required: false
        selector:
          select:
            options: [[ eq_presets | list | tojson ]]
    sequence:
      - variables:
          chosen: "{{ preset | default(states('input_select.[[ p ]]_music_eq')) }}"
      - if:
          - condition: template
            value_template: >-
              {{ chosen not in [[ eq_presets | list | tojson ]] }}
        then:
          - action: system_log.write
            data:
              level: warning
              logger: [[ p ]].music_look
              message: "no EQ preset '{{ chosen }}', so Custom's EQ is unchanged"
          - stop: No such EQ preset
      - variables:
          gains: >-
            {{ [[ eq_presets | tojson ]][chosen] }}
[%- for key in eq_keys %]
      - action: input_number.set_value
        target:
          entity_id: input_number.[[ p ]]_music_eq_[[ key ]]
        data:
          value: "{{ gains.[[ key ]] }}"
[%- endfor %]
[%- endif %]

  # Sets the settings to this home's defaults (settings_defaults and music_visual_options over the
  # catalog's). `page`: only that page's settings; `groups`: only those groups'; both: the settings
  # in both; neither: every setting, ambient_music too. The seed automation calls it with groups,
  # the settings dashboard's Reset buttons with a page or with nothing. It never touches
  # audio-sensor's music source or calibration: a measurement is not a preference. The one
  # audio-sensor helper it sets is the sensor update rate on Music, Advanced, and only while it is
  # there: a home without audio-sensor skips the step.
  [[ p ]]_settings_reset:
    alias: [[ named(' reset settings') ]]
    icon: mdi:restore
    mode: queued
    fields:
      page:
        name: Page
        description: Only the settings of this page.
        selector:
          select:
            options: [[ reset_pages | tojson ]]
      groups:
        name: Groups
        description: Only the settings of these groups.
        selector:
          select:
            multiple: true
            options: ["presence_display", "pages", "music_visual", "music_look", "photos", "plants", "air", "climate"]
    sequence:
      - variables:
          only_page: "{{ page | default('', true) }}"
          only_groups: >-
            {% set g = groups | default([], true) %}{{ [g] if g is string else g | list }}
[%- set blocks = [] %]
[%- for s in settings %]
[%- if not blocks or blocks[-1].page != s[2] or blocks[-1].group != s[3] %][% set _ = blocks.append({'page': s[2], 'group': s[3], 'items': []}) %][% endif %]
[%- set _ = blocks[-1]['items'].append(s) %]
[%- endfor %]
[%- for block in blocks %]
[%- set on_page = "== ''" if block.page == '' else "in ['', '" ~ block.page ~ "']" %]
      - if:
          - condition: template
            value_template: >-
              {{ only_page [[ on_page ]] and (not only_groups or '[[ block.group ]]' in only_groups) }}
        then:
[%- for domain, key, _page, _group, value in block['items'] %]
[%- if domain == 'event' %]
          - event: [[ p ]]_[[ key ]]
            event_data: [[ value | tojson ]]
[%- else %]
[%- set verb = 'set_value' if domain in ['input_number', 'input_text'] else 'select_option' if domain == 'input_select' else 'turn_on' if value else 'turn_off' %]
          - action: [[ domain ]].[[ verb ]]
            target:
              entity_id: [[ domain ]].[[ p ]]_[[ key ]]
[%- if domain == 'input_number' %]
            data:
              value: [[ value ]]
[%- elif domain == 'input_text' %]
            data:
              value: [[ value | yaml ]]
[%- elif domain == 'input_select' %]
            data:
              option: [[ value | yaml ]]
[%- endif %]
[%- endif %]
[%- endfor %]
[%- endfor %]
[%- if music_visual %]
      - if:
          - condition: template
            value_template: >-
              {{ only_page in ['', 'music'] and (not only_groups or 'music_visual' in only_groups)
                 and states('input_select.audio_sensor_music_spectrum_rate') not in ['unknown', 'unavailable'] }}
        then:
          - action: input_select.select_option
            target:
              entity_id: input_select.audio_sensor_music_spectrum_rate
            data:
              option: normal
[%- endif %]

# One automation per transition; none shares state with another, so no mode: restart races.
automation:
  # The About page's discovery at start and nightly, so the list is current without a Refresh
  # (SPEC-023). The registries are on disk before start ends; a minute lets HACS load first.
  - id: [[ p ]]_about_discover
    alias: [[ named(' about discover') ]]
    mode: single
    triggers:
      - trigger: homeassistant
        event: start
      - trigger: time
        at: "04:10:00"
    actions:
      - delay: "00:01:00"
      - action: script.[[ p ]]_about_refresh

  # 1. Someone arrives while the tablet sleeps.
  - id: [[ p ]]_presence_on
    alias: [[ named(' presence on') ]]
    description: "Radar presence while the tablet is off: show ambient and wake the screen."
    mode: single
    max_exceeded: silent
    triggers:
      - trigger: state
        entity_id: [[ radar.presence ]]
        to: "on"
    conditions:
      - condition: state
        entity_id: input_select.[[ p ]]_mode
        state: "off"
    actions:
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: ambient
      - action: script.[[ p ]]_screen_on

  # 2. Nobody for off_delay_s. The `for` is rendered when presence drops, so a changed helper
  #    takes effect on the next drop.
  - id: [[ p ]]_presence_off
    alias: [[ named(' presence off') ]]
    description: "No radar presence for the configured delay: sleep the screen."
    mode: single
    max_exceeded: silent
    triggers:
      - trigger: state
        entity_id: [[ radar.presence ]]
        to: "off"
        for:
          seconds: "{{ states('input_number.[[ p ]]_off_delay_s') | int([[ d.off_delay_s ]]) }}"
    conditions:
      - condition: not
        conditions:
          - condition: state
            entity_id: input_select.[[ p ]]_mode
            state: "off"
    actions:
      - action: timer.cancel
        target:
          entity_id: timer.[[ p ]]_controls
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: "off"
      - action: script.[[ p ]]_screen_off

  # 3. Someone right at the tablet: binary_sensor.[[ p ]]_near (the radar's target within
  #    near_cm, gaps under 2 s bridged) on for near_s. 100 cm for 1 s puts a person at the screen
  #    (45-65 cm) inside and anyone at a table (180-260 cm) outside. The trigger fires again only
  #    after the sensor has been off (the person stepped back), so each new approach restarts the
  #    timer (timer.start on a running timer restarts it), and a hand on the screen is a target at
  #    30 cm, so touching keeps the controls up.
  - id: [[ p ]]_near
    alias: [[ named(' near movement') ]]
    description: Movement within the near distance shows the controls and (re)starts the hold timer.
    mode: single
    max_exceeded: silent
    triggers:
      - trigger: state
        entity_id: binary_sensor.[[ p ]]_near
        to: "on"
        for:
          seconds: "{{ states('input_number.[[ p ]]_near_s') | int([[ d.near_s ]]) }}"
    conditions:
      - condition: state
        entity_id: input_boolean.[[ p ]]_near_enabled
        state: "on"
    actions:
      # A wave can arrive before the presence automation has run: wake the screen here too.
      - if:
          - condition: state
            entity_id: input_select.[[ p ]]_mode
            state: "off"
        then:
          - action: script.[[ p ]]_screen_on
      - action: script.[[ p ]]_show_controls

  # Watchdog for the loop: it is the one piece that can die quietly (a script error ends it). If
  # the tablet sits in ambient with the player silent and the loop off for a minute, start it
  # again and say so in the logbook.
  - id: [[ p ]]_ambient_watchdog
    alias: [[ named(' ambient watchdog') ]]
    description: "Loop off for a minute while the frame is in ambient: restart it."
    mode: single
    triggers:
      - trigger: state
        entity_id: script.[[ p ]]_ambient_loop
        to: "off"
        for: "00:01:00"
      - trigger: time_pattern
        minutes: "/5"
    conditions:
      - condition: state
        entity_id: script.[[ p ]]_ambient_loop
        state: "off"
      - condition: state
        entity_id: input_select.[[ p ]]_mode
        state: ambient
      - condition: state
        entity_id: binary_sensor.[[ p ]]_music_view
        state: "off"
    actions:
      - action: logbook.log
        data:
          name: Ramka
          message: "ambient loop was off, restarted by the watchdog"
          entity_id: script.[[ p ]]_ambient_loop
      - action: script.turn_on
        target:
          entity_id: script.[[ p ]]_ambient_loop

  # Auto brightness: follow the light sensor while the screen is on. The target changes only
  #    when the lux reading does (once a minute at most), and small steps are skipped.
  - id: [[ p ]]_auto_brightness
    alias: [[ named(' auto brightness') ]]
    description: "Light sensor moved: set the screen brightness to the target, unless the tablet is off."
    mode: single
    max_exceeded: silent
    triggers:
      - trigger: state
        entity_id: sensor.[[ p ]]_brightness_target
    conditions:
      - condition: not
        conditions:
          - condition: state
            entity_id: input_select.[[ p ]]_mode
            state: "off"
      # Skip steps under 8; a manual run (no trigger object) always sends.
      - condition: template
        value_template: >-
          {{ trigger is not defined or trigger.platform is none
             or trigger.from_state is none
             or trigger.from_state.state in ['unknown', 'unavailable']
             or (trigger.to_state.state | int(0) - trigger.from_state.state | int(0)) | abs >= 8 }}
    actions:
      - action: [[ notify ]]
        data:
          message: command_screen_brightness_level
          data:
            command: "{{ states('sensor.[[ p ]]_brightness_target') | int(120) }}"

  # 4. The hold ran out.
  # Leaving the near zone while the controls are up starts the hold; the timer's end is the way
  # back to ambient. Coming back within the hold cancels it (the near automation above).
  - id: [[ p ]]_near_left
    alias: [[ named(' near left') ]]
    description: "Nobody within near_cm any more: the controls (or the calendar) stay controls_hold_s longer."
    mode: single
    triggers:
      - trigger: state
        entity_id: binary_sensor.[[ p ]]_near
        to: "off"
    conditions:
      - condition: state
        entity_id: input_select.[[ p ]]_mode
        state:
          - controls
          - calendar
    actions:
      - action: timer.start
        target:
          entity_id: timer.[[ p ]]_controls
        data:
          duration: "{{ states('input_number.[[ p ]]_controls_hold_s') | int([[ d.controls_hold_s ]]) }}"

  - id: [[ p ]]_controls_timeout
    alias: [[ named(' controls timeout') ]]
    description: "The controls hold timer finished: back to ambient."
    mode: single
    triggers:
      - trigger: event
        event_type: timer.finished
        event_data:
          entity_id: timer.[[ p ]]_controls
    conditions:
      - condition: state
        entity_id: input_select.[[ p ]]_mode
        state:
          - controls
          - calendar
    actions:
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_mode
        data:
          option: ambient
[%- if inputs.photo_dir is defined %]

  # Rebuild the photo index (captions) at start, every 15 minutes (the folder sensor sees only
  # one level, and photos sit deeper), and when that sensor sees a change anyway.
  - id: [[ p ]]_photo_index
    alias: [[ named(' photo index') ]]
    description: [[ index_description | yaml ]]
    mode: single
    triggers:
      - trigger: homeassistant
        event: start
      - trigger: time_pattern
        minutes: "/15"
      - trigger: state
        entity_id: [[ folder_sensor ]]
        attribute: number_of_files
    actions:
      - action: shell_command.[[ p ]]_index
      # The albums to choose from, for sensor.[[ p ]]_photo_albums (the chosen ones stay).
      - action: shell_command.[[ p ]]_albums
        response_variable: albums
      - event: [[ p ]]_photo_albums
        event_data:
          available: >-
            {% set lines = (albums.stdout | default('')).strip().splitlines() %}
            {{ (lines | last | from_json).albums if lines else [] }}
[%- endif %]

  # 5. The ambient rhythm: climate 30 s, air 15 s, plants 20 s, a photo series (five of 10 s by
  #    default), status 15 s, and again.
  #    A looping script (mode restart) rather than a time_pattern, so the slots are exact. It
  #    starts when the tablet enters ambient or the player stops, and is stopped when the mode
  #    leaves ambient or the player starts (the dashboard shows now-playing then, and the photo
  #    must not change underneath it).
  - id: [[ p ]]_ambient_start
    alias: [[ named(' ambient start') ]]
    description: "Ambient entered, or the music view gone: run the climate/photos loop."
    mode: single
    triggers:
      - trigger: state
        entity_id: input_select.[[ p ]]_mode
        to: ambient
      - trigger: state
        entity_id: binary_sensor.[[ p ]]_music_view
        to: "off"
      - trigger: homeassistant
        event: start
    conditions:
      - condition: state
        entity_id: input_select.[[ p ]]_mode
        state: ambient
      - condition: state
        entity_id: binary_sensor.[[ p ]]_music_view
        state: "off"
    actions:
      - action: script.turn_on
        target:
          entity_id: script.[[ p ]]_ambient_loop
  - id: [[ p ]]_music_back
    alias: [[ named(' music back') ]]
    description: "The media player starts playing from silence: ambient shows the music again."
    mode: single
    triggers:
      # Only from a silent state: a track change is buffering → paused → playing within a second
      # and must not undo the swipe. A start can pass through buffering (off → on → buffering →
      # playing when an amplifier wakes from standby), so the trigger takes the step out of
      # silence into buffering too; with `to: playing` alone it can miss every start.
      - trigger: state
        entity_id: [[ inputs.media_player ]]
        from: ["off", "on", "idle", "unavailable"]
        to: [buffering, playing]
    actions:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.[[ p ]]_ambient_music
[%- if music_visual %]
  # audio-sensor sends its fast data only while someone can see it: the watching flag is on while
  # this Ramka's music view is, or another Ramka's (one flag per home, never toggled). The grace
  # before the board drops back to normal is audio-sensor's. A home without audio-sensor has no flag.
  - id: [[ p ]]_music_watching
    alias: [[ named(' music watching') ]]
    description: "The music view on or off: audio-sensor's watching flag follows, on while any Ramka's music view is."
    mode: queued
    triggers:
      - trigger: state
        entity_id: binary_sensor.[[ p ]]_music_view
        to: ["on", "off"]
      - trigger: homeassistant
        event: start
    conditions:
      - condition: template
        value_template: "{{ states('input_boolean.audio_sensor_music_watching') not in ['unknown', 'unavailable'] }}"
    actions:
      - if:
          - condition: template
            value_template: >-
              {% set ns = namespace(on=false) %}{% for s in states.binary_sensor if s.entity_id.endswith('_music_view')
                 and s.attributes.component == 'ramka' and s.state == 'on' %}{% set ns.on = true %}{% endfor %}{{ ns.on }}
        then:
          - action: input_boolean.turn_on
            target:
              entity_id: input_boolean.audio_sensor_music_watching
        else:
          - action: input_boolean.turn_off
            target:
              entity_id: input_boolean.audio_sensor_music_watching
  # An EQ preset chosen loads into Custom's EQ (spec 5), whichever profile is on. Not when the select appears at a start or a reload (no old
  # state, or unavailable): that is the restored state, no choice, and would undo Custom's sliders.
  - id: [[ p ]]_music_eq_load
    alias: [[ named(' music EQ load') ]]
    description: "An EQ preset chosen: write its six gains into Custom's EQ."
    mode: restart
    triggers:
      - trigger: state
        entity_id: input_select.[[ p ]]_music_eq
        to: ~
    conditions:
      - condition: template
        value_template: "{{ trigger.from_state is not none and trigger.from_state.state not in ['unknown', 'unavailable'] }}"
    actions:
      - action: script.[[ p ]]_music_load_eq
        data:
          preset: "{{ trigger.to_state.state }}"
[%- endif %]
  - id: [[ p ]]_ambient_stop
    alias: [[ named(' ambient stop') ]]
    description: "Ambient left, or the music view on: stop the loop and rest on the climate page."
    mode: single
    triggers:
      - trigger: state
        entity_id: input_select.[[ p ]]_mode
        from: ambient
      - trigger: state
        entity_id: binary_sensor.[[ p ]]_music_view
        to: "on"
    actions:
      - action: script.turn_off
        target:
          entity_id: script.[[ p ]]_ambient_loop
      - action: input_select.select_option
        target:
          entity_id: input_select.[[ p ]]_ambient
        data:
          option: >-
            {{ [[ live ]] | first }}
  # ---- Live settings (0.4.0) -----------------------------------------------------------------
  # The settings' starting values, once. The flag is new in 0.4.0, so it is off on the first start
  # of every home, also one that has run the Ramka for months: a group is seeded only while it is
  # untouched, each of its numbers `unknown`, `unavailable` or at its own minimum (what Home
  # Assistant gives a helper without `initial:` and without a restored state). Per group, not per
  # helper, so a home that set one value to its minimum on purpose keeps it.
  # - presence_display: the seven numbers untouched (an upgraded home keeps them, and its
  #   booleans, which cannot tell a fresh off from a chosen one); only while the flag is off;
  # - pages (theme, the Advanced switch, the page switches): new in 0.4.0 in every home, so seeded
  #   whenever the flag is off, or an upgraded home would find every page switched off;
  # - music_visual: the four dB helpers untouched (0 dB); also after the flag is on, since a home
  #   can add music_visual later;
  # - music_look: Custom's six EQ gains and its hold untouched (-18 dB, 0 s); also after the flag is
  #   on, so a home that had music_visual before the looks gets a flat EQ;
  # - photos and air (SPEC-021 amendment 1): their numbers untouched; also after the flag is on, so
  #   a home that ran 0.4.0 before them gets them at its next start.
  # Home Assistant's start trigger fires after the restored states are in place.
  - id: [[ p ]]_settings_seed
    alias: [[ named(' settings seed') ]]
    description: "Start: give untouched settings their starting values, once; a home's tuning stays."
    mode: single
    triggers:
      - trigger: homeassistant
        event: start
    actions:
      - variables:
          seed_groups: >-
            {% set untouched = namespace(presence=true, music=true, look=true, photos=true, plants=true, air=true) %}
[%- if inputs.climate is defined %]
            {% set untouched_climate = state_attr('sensor.[[ p ]]_climate_rooms', 'rooms') is none %}
[%- endif %]
            {% for e in ['input_number.[[ p ]]_off_delay_s', 'input_number.[[ p ]]_brightness_min', 'input_number.[[ p ]]_brightness_max', 'input_number.[[ p ]]_near_cm', 'input_number.[[ p ]]_near_s', 'input_number.[[ p ]]_controls_hold_s', 'input_number.[[ p ]]_lux_max'] if states(e) not in ['unknown', 'unavailable'] and states(e) | float(-1) != state_attr(e, 'min') | float(-2) %}{% set untouched.presence = false %}{% endfor %}
[%- set photo_numbers = [] if inputs.photo_dir is not defined else ['input_number.' ~ p ~ '_photo_count', 'input_number.' ~ p ~ '_photo_s'] %]
[%- set plant_numbers = [] if inputs.plants is not defined else ['input_number.' ~ p ~ '_plants_per_page', 'input_number.' ~ p ~ '_plants_page_s'] %]
[%- set air_numbers = [] %]
[%- for s in settings if s[3] == 'air' and s[0] == 'input_number' %][% set _ = air_numbers.append('input_number.' ~ p ~ '_' ~ s[1]) %][% endfor %]
[%- for group, numbers in [('photos', photo_numbers), ('plants', plant_numbers), ('air', air_numbers)] if numbers %]
            {% for e in [[ numbers | tojson ]] if states(e) not in ['unknown', 'unavailable'] and states(e) | float(-1) != state_attr(e, 'min') | float(-2) %}{% set untouched.[[ group ]] = false %}{% endfor %}
[%- endfor %]
[%- if music_visual %]
            {% for e in ['input_number.[[ p ]]_music_spectrum_neutral_db', 'input_number.[[ p ]]_music_spectrum_hot_db', 'input_number.[[ p ]]_music_level_neutral_db', 'input_number.[[ p ]]_music_level_hot_db'] if states(e) not in ['unknown', 'unavailable'] and states(e) | float(-1) != state_attr(e, 'min') | float(-2) %}{% set untouched.music = false %}{% endfor %}
[%- set look_numbers = [] %]
[%- for s in settings if s[3] == 'music_look' and s[0] == 'input_number' %][% set _ = look_numbers.append('input_number.' ~ p ~ '_' ~ s[1]) %][% endfor %]
            {% for e in [[ look_numbers | tojson ]] if states(e) not in ['unknown', 'unavailable'] and states(e) | float(-1) != state_attr(e, 'min') | float(-2) %}{% set untouched.look = false %}{% endfor %}
[%- endif %]
            {% set first = not is_state('input_boolean.[[ p ]]_settings_seeded', 'on') %}
            {{ ((['pages'] + (['presence_display'] if untouched.presence else [])) if first else [])[% if music_visual %] + (['music_visual'] if untouched.music else []) + (['music_look'] if untouched.look else [])[% endif %][% if photo_numbers %] + (['photos'] if untouched.photos else [])[% endif %][% if plant_numbers %] + (['plants'] if untouched.plants else [])[% endif %][% if air_numbers %] + (['air'] if untouched.air else [])[% endif %][% if inputs.climate is defined %] + (['climate'] if untouched_climate else [])[% endif %] }}
      - if:
          - condition: template
            value_template: "{{ seed_groups | count > 0 }}"
        then:
          - action: script.[[ p ]]_settings_reset
            data:
              groups: "{{ seed_groups }}"
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.[[ p ]]_settings_seeded

  # The server's default theme follows the theme mode, at start and on every change. Both of the
  # server's default-theme slots get it (frontend.set_theme without mode and with mode: dark), so a
  # browser shows it whatever its own dark-mode setting. It reaches every user whose profile theme is
  # "Backend-selected", on every dashboard; a user who picks a theme in the profile keeps it.
  - id: [[ p ]]_theme_mode
    alias: [[ named(' theme mode') ]]
    description: "Start, or the theme mode changed: set the server's default theme to ramka-<mode>."
    mode: queued
    triggers:
      - trigger: homeassistant
        event: start
      - trigger: state
        entity_id: input_select.[[ p ]]_theme_mode
        to: ~
    actions:
      - variables:
          theme: >-
            {% set mode = states('input_select.[[ p ]]_theme_mode') %}ramka-{{ mode if mode in ['dark', 'light'] else '[[ d.theme_mode ]]' }}
      - action: frontend.set_theme
        data:
          name: "{{ theme }}"
      - action: frontend.set_theme
        data:
          name: "{{ theme }}"
          mode: dark
[%- if inputs.alert_notify is defined %]

  # ---- Battery alerts ------------------------------------------------------------------------
  # A tablet that holds its own charge limit (charges to 80 % and runs off the mains from there)
  # needs no smart plug. What is left is the alerts: a tablet without a charger or draining is a
  # charger or a cable that is gone, and a hot battery is something to hear about even though HA
  # cannot cut the power.
  - id: [[ p ]]_charger_failed
    alias: [[ named(' charger failed') ]]
    description: "No charger for 30 minutes, or the battery under 20 % for 30 minutes: send an alert."
    mode: single
    triggers:
      - trigger: state
        id: unplugged
        entity_id: sensor.[[ ts ]]_charger_type
        to: none
        for: "00:30:00"
      - trigger: numeric_state
        id: low
        entity_id: sensor.[[ ts ]]_battery_level
        below: 20
        for: "00:30:00"
    actions:
      - action: [[ inputs.alert_notify ]]
        data:
          title: [[ inputs.alert_title | default(name) | yaml ]]
          message: >-
            The tablet is at {{ states('sensor.[[ ts ]]_battery_level') }} %, charger
            {{ states('sensor.[[ ts ]]_charger_type') }},
            {{ 'charging' if is_state('binary_sensor.[[ ts ]]_is_charging', 'on') else 'not charging' }}.
            Check the cable and the charger.
  - id: [[ p ]]_battery_hot
    alias: [[ named(' battery hot') ]]
    description: "Battery above 42 °C: send an alert."
    mode: single
    triggers:
      - trigger: numeric_state
        entity_id: sensor.[[ ts ]]_battery_temperature
        above: 42
    actions:
      - action: [[ inputs.alert_notify ]]
        data:
          title: [[ inputs.alert_title | default(name) | yaml ]]
          message: >-
            Battery at {{ states('sensor.[[ ts ]]_battery_temperature') }} °C. Pull the charger
            until it has cooled; HA has no plug to do it.
[%- endif %]
