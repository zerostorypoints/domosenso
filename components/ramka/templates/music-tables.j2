[#- The music tables both the package and the settings dashboard render from (SPEC-024): the six EQ
    ranges, the catalog's EQ presets (each -18...+12 dB per range; `behind_speakers` and `half_match`
    are one measurement, a sensor on an amplifier between the speakers against the listening
    position, and half of it; `fitted` is flat until a home sets it; the WLED rows are derived from
    WLED-MM's frequency profiles) and the response profiles' ids, Custom first. Imported, never
    rendered on its own: a template copies the presets before a home's music_eq_presets replace any. -#]
[%- set eq_keys = ['sub', 'bass', 'low_mid', 'mid', 'presence', 'air'] -%]
[%- set catalog_eq_presets = {
    'flat': {'sub': 0, 'bass': 0, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0},
    'behind_speakers': {'sub': -5, 'bass': -10, 'low_mid': -3, 'mid': 0, 'presence': 3, 'air': 2},
    'half_match': {'sub': -2, 'bass': -5, 'low_mid': -1, 'mid': 0, 'presence': 2, 'air': 1},
    'wled_big_speakers': {'sub': -4, 'bass': -2, 'low_mid': -5, 'mid': 0, 'presence': 1, 'air': 2},
    'wled_big_speakers_ics': {'sub': -3, 'bass': -4, 'low_mid': -4, 'mid': 0, 'presence': 2, 'air': -1},
    'wled_pink': {'sub': -2, 'bass': 1, 'low_mid': 2, 'mid': 0, 'presence': 2, 'air': 4},
    'bass_light': {'sub': -8, 'bass': -6, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0},
    'voices': {'sub': -6, 'bass': -8, 'low_mid': -2, 'mid': 3, 'presence': 4, 'air': 0},
    'sparkle': {'sub': -3, 'bass': -3, 'low_mid': 0, 'mid': 0, 'presence': 3, 'air': 5},
    'fitted': {'sub': 0, 'bass': 0, 'low_mid': 0, 'mid': 0, 'presence': 0, 'air': 0}} -%]
[#- The EQ select's resting option: no preset; a choice loads and the select returns to it, so a
    profile card never shows a preset another profile loaded, and the same preset can be chosen again. -#]
[%- set eq_none = '—' -%]
[%- set look_ids = ['custom', 'behind_speakers', 'lively', 'calm', 'analyser'] -%]
