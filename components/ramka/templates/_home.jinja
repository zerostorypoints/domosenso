[#- The Ramka's inputs with the shared home inputs behind them (P3, docs/2026-11-05-shared-home-decisions.md).
   Each template imports `merged` as `inputs`:   [%- from '_home.jinja' import merged as inputs with context -%]
   An input the Ramka's own file gives wins, unchanged. Without it, and with home inputs, it comes from
   the home's rooms:
     lights   each room's lights (a light, a group, or a list; a listed {entity, name} keeps its name),
              labelled with the room's name, room = the room's id
     climate  each room with climate: {label: the room's name, temperature, humidity?, room}
     outside  the home's outside {temperature, humidity?}
     air      every room with air: {label: the room's name, room, its readings}, a page each (0.19.0)
     weather  the home's weather
     covers   each room's listed covers: {entity, label: its name, else the room's, room}
     status   contacts and locks from the rooms' lists, {entity, label}, beside the Ramka's own status
              keys (a key the Ramka gives wins)
   Colours, the wall's layout and every other input stay the Ramka's own. -#]
[%- from '_air-policy.jinja' import air_limits -%]
[%- set merged = dict(inputs) -%]
[#- P3.3: the thresholds the wall reads. `thresholds: climate-air` points every air limit at
    climate-air's helpers (input_number.climate_air_<reading>_{fair,poor}) and, with home inputs, each
    room's comfort range at input_number.climate_air_<room>_{temp,humidity}_{low,high}, keyed by the
    room's temperature sensor; otherwise the Ramka's own (input_number.<prefix>_air_<reading>_<key>). -#]
[%- set shared = inputs.thresholds is defined and inputs.thresholds == 'climate-air' -%]
[%- set limit_ids = {} -%]
[%- for reading, l in air_limits.items() -%]
  [%- set _ = limit_ids.update({reading: (['input_number.climate_air_' ~ reading ~ '_fair', 'input_number.climate_air_' ~ reading ~ '_poor'] if shared
        else ['input_number.' ~ inputs.prefix ~ '_air_' ~ reading ~ '_' ~ l[0], 'input_number.' ~ inputs.prefix ~ '_air_' ~ reading ~ '_' ~ l[1]])}) -%]
[%- endfor -%]
[%- set _ = merged.update({'air_limit_ids': limit_ids, 'shared_thresholds': shared}) -%]
[%- if home is defined and home -%]
[%- macro _name(item, room) -%][[ room_name(item) if item is mapping and item.name is defined else room_name(room) ]][%- endmacro -%]
[%- set ns = namespace(lights=[], climate=[], covers=[], contacts=[], locks=[], air=[]) -%]
[%- for room in home.rooms -%]
  [%- if room.lights is defined -%]
    [%- for item in ([room.lights] if room.lights is string else room.lights) -%]
      [%- set ns.lights = ns.lights + [{'entity': item if item is string else item.entity, 'label': _name(item, room), 'room': room.id}] -%]
    [%- endfor -%]
  [%- endif -%]
  [%- if room.climate is defined -%]
    [%- set row = {'label': room_name(room), 'temperature': room.climate.temperature, 'room': room.id} -%]
    [%- if room.climate.humidity is defined %][% set _ = row.update({'humidity': room.climate.humidity}) %][% endif -%]
    [%- set ns.climate = ns.climate + [row] -%]
  [%- endif -%]
  [%- if room.air is defined %][% set ns.air = ns.air + [dict(room.air, label=room_name(room), room=room.id)] %][% endif -%]
  [%- for kind in ('covers', 'contacts', 'locks') if room[kind] is defined -%]
    [%- for item in room[kind] -%]
      [%- set row = {'entity': item if item is string else item.entity, 'label': _name(item, room)} -%]
      [%- if kind == 'covers' %][% set _ = row.update({'room': room.id}) %][% set ns.covers = ns.covers + [row] -%]
      [%- elif kind == 'contacts' %][% set ns.contacts = ns.contacts + [row] -%]
      [%- else %][% set ns.locks = ns.locks + [row] %][% endif -%]
    [%- endfor -%]
  [%- endfor -%]
[%- endfor -%]
[%- if inputs.lights is not defined and ns.lights %][% set _ = merged.update({'lights': ns.lights}) %][% endif -%]
[%- if inputs.climate is not defined and ns.climate %][% set _ = merged.update({'climate': ns.climate}) %][% endif -%]
[%- if shared -%]
  [%- set comfort = {} -%]
  [%- for room in home.rooms if room.climate is defined -%]
    [%- set ids = {'temp_low': 'input_number.climate_air_' ~ room.id ~ '_temp_low', 'temp_high': 'input_number.climate_air_' ~ room.id ~ '_temp_high'} -%]
    [%- if room.climate.humidity is defined %][% set _ = ids.update({'hum_low': 'input_number.climate_air_' ~ room.id ~ '_humidity_low', 'hum_high': 'input_number.climate_air_' ~ room.id ~ '_humidity_high'}) %][% endif -%]
    [%- set _ = comfort.update({room.climate.temperature: ids}) -%]
  [%- endfor -%]
  [%- set _ = merged.update({'comfort_ids': comfort}) -%]
[%- endif -%]
[%- if inputs.covers is not defined and ns.covers %][% set _ = merged.update({'covers': ns.covers}) %][% endif -%]
[%- if inputs.air is not defined and ns.air %][% set _ = merged.update({'air': ns.air}) %][% endif -%]
[%- if inputs.weather is not defined and home.weather is defined %][% set _ = merged.update({'weather': home.weather}) %][% endif -%]
[%- if inputs.outside is not defined and home.outside is defined -%]
  [%- set out = {'temperature': home.outside.temperature} -%]
  [%- if home.outside.humidity is defined %][% set _ = out.update({'humidity': home.outside.humidity}) %][% endif -%]
  [%- set _ = merged.update({'outside': out}) -%]
[%- endif -%]
[%- set status = dict(inputs.status) if inputs.status is defined and inputs.status else {} -%]
[%- if status.contacts is not defined and ns.contacts %][% set _ = status.update({'contacts': ns.contacts}) %][% endif -%]
[%- if status.locks is not defined and ns.locks %][% set _ = status.update({'locks': ns.locks}) %][% endif -%]
[%- if status %][% set _ = merged.update({'status': status}) %][% endif -%]
[%- endif -%]
[#- 0.19.0: `air` is one set of readings (a mapping, as before) or a list of rooms, each
    {label, room?, score?, co2?, pm2_5?, voc?, nox?}: the Air page gets a page per room. The templates
    read `air_rooms` (the list, one item for a mapping) for the pages and `air` (every reading any room
    has, the first room's entity for each) for the helpers, switches and limits, which all rooms share. -#]
[%- set _air = merged.air if merged.air is defined else none -%]
[%- if _air is mapping %][% set _rooms = [_air] %][% elif _air %][% set _rooms = _air | list %][% else %][% set _rooms = [] %][% endif -%]
[%- for room in _rooms -%]
  [%- if not (air_limits | select('in', room) | list) -%][[ fail('ramka: air: every room needs a reading (score, co2, pm2_5, voc or nox)') ]][%- endif -%]
  [%- if _rooms | length > 1 and (room.label is not defined or not room.label) -%][[ fail('ramka: air: with more than one room every room needs a label') ]][%- endif -%]
[%- endfor -%]
[%- if _rooms -%]
  [%- set union = {} -%]
  [%- for room in _rooms -%]
    [%- for reading in air_limits if room[reading] is defined and reading not in union %][% set _ = union.update({reading: room[reading]}) %][% endfor -%]
  [%- endfor -%]
  [%- set _ = merged.update({'air': union, 'air_rooms': _rooms}) -%]
[%- endif -%]
