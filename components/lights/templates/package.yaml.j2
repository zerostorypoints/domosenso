[#
  The lights component's Home Assistant package (SPEC-008): room lights that follow the bulbs, the
  lights-on count and the lowest Hue battery. Rendered once per home (lang en) by
  tools/domosenso_render.py; double square brackets are the renderer's, {{ }} / {% %} stay for Home
  Assistant. Inputs: component.yaml `inputs:`.
#]
[%- set rooms = inputs.rooms | default([]) -%]
[%- set batteries = inputs.battery_sensors | default([]) -%]
[%- set battery_list = batteries | tojson | replace('"', "'") -%]
[%- set presence_rooms = inputs.presence_rooms | default([]) -%]
[%- for room in presence_rooms %][% if room.illuminance is defined and room.illuminance is not none and (room.dark_below is not defined or room.dark_below is none) %][[ fail('presence_rooms: ' ~ room.name ~ ' has illuminance but no dark_below') ]][% endif %][% endfor -%]
# Hue lights, from the Domosenso catalog (component lights). Edit the inputs and render again rather
# than editing this file.

template:
  - sensor:
      - name: Lights on
        unique_id: lights_on_count
        icon: mdi:lightbulb-group
        state_class: measurement
        # Individual Hue bulbs that are on (room groups and zones excluded, and so are the room_*
        # template lights below, which are not Hue entities).
        state: >
          {{ integration_entities('hue') | select('match', 'light\\.') | expand
             | rejectattr('attributes.is_hue_group', 'eq', true)
             | selectattr('state', 'eq', 'on')
             | list | count }}
        attributes:
          component: lights
[%- if batteries %]
      - name: Hue lowest battery
        unique_id: hue_lowest_battery
        unit_of_measurement: "%"
        device_class: battery
        state_class: measurement
        # Unavailable while no battery sensor has a value (a Zigbee mesh falling apart, or the first
        # seconds after a start): a numeric sensor that renders "unknown" logs an ERROR each time.
        availability: >-
          {{ [[ battery_list ]] | select('has_value') | list | count > 0 }}
        state: >-
          {{ [[ battery_list ]] | select('has_value') | map('states') | map('int') | min }}
        attributes:
          component: lights
[%- endif %]
[%- if rooms %]

  # Room lights as they really are. Where lights are switched at the wall, the switch cuts the
  # bulbs' power: they drop off the Zigbee mesh and go unavailable, and the bridge's grouped light
  # keeps the state it had when they went, "on" all night with every bulb dead. Polling would not
  # help: Home Assistant already follows the bridge's event stream, and the group's state is what the
  # bridge sends.
  #
  # Each light here mirrors one Hue room and counts as on only while one of its bulbs is reachable
  # and on; a room whose bulbs have all lost power is off. Commands go to the Hue group, so the
  # bridge still switches the room in one Zigbee broadcast. Unavailable only when the group is, i.e.
  # when the bridge cannot be reached.
  - light:
[%- for room in rooms %]
[%- set g = room.group %]
[%- set id = room.id | default(g.split('.', 1)[1]) %]
      - name: [[ room.name | yaml ]]
        unique_id: room_[[ id ]]
        default_entity_id: light.room_[[ id ]]
        icon: mdi:lightbulb-group
        availability: "{{ has_value('[[ g ]]') }}"
        state: >-
          {{ expand(state_attr('[[ g ]]', 'entity_id') or [])
             | selectattr('state', 'eq', 'on') | list | count > 0 }}
        level: "{{ state_attr('[[ g ]]', 'brightness') }}"
        temperature: >-
          {% set k = state_attr('[[ g ]]', 'color_temp_kelvin') %}
          {{ (1000000 / k) | round | int if k else none }}
        min_mireds: "{{ (1000000 / state_attr('[[ g ]]', 'max_color_temp_kelvin') | float(6500)) | round | int }}"
        max_mireds: "{{ (1000000 / state_attr('[[ g ]]', 'min_color_temp_kelvin') | float(2000)) | round | int }}"
        turn_on:
          - action: light.turn_on
            target: {entity_id: [[ g ]]}
        turn_off:
          - action: light.turn_off
            target: {entity_id: [[ g ]]}
        set_level:
          - action: light.turn_on
            target: {entity_id: [[ g ]]}
            data: {brightness: "{{ brightness }}"}
        set_temperature:
          - action: light.turn_on
            target: {entity_id: [[ g ]]}
            # A call with both runs only this action; brightness comes along when given.
            data: >-
              {{ {'color_temp_kelvin': color_temp_kelvin}
                 | combine({'brightness': brightness} if brightness is defined and brightness is not none else {}) }}
        attributes:
          component: lights
[%- endfor %]
[%- endif %]
[%- if presence_rooms %]

  # Presence rooms (SPEC-053). The ambient reading follows the room's illuminance only while no bulb
  # of the group is on and holds its last value while one is: a sensor in the room sees the room's
  # own light, and without the hold a quick return after an automatic switch-off would read as
  # daylight.
[%- for room in presence_rooms %]
[%- set id = room.id | default(room.group.split('.', 1)[1]) %]
[%- if room.illuminance is defined and room.illuminance is not none %]
  # Only the illuminance triggers it: on a trigger from the group the moment the bulbs report off,
  # the sensor would still hold the reading taken with the lamp lit, and a sparse sensor keeps it
  # in the window for up to two minutes. The first reading after the lamp is dark is the next one.
  - triggers:
      - trigger: state
        entity_id: [[ room.illuminance ]]
    sensor:
      [%- set label = room.name ~ ' presence ambient' %]
      - name: [[ label | yaml ]]
        unique_id: lights_presence_[[ id ]]_ambient
        default_entity_id: sensor.lights_presence_[[ id ]]_ambient
        state: >-
          {% set lit = expand(state_attr('[[ room.group ]]', 'entity_id') or [])
                       | selectattr('state', 'eq', 'on') | list | count > 0 %}
          {{ this.state if lit else states('[[ room.illuminance ]]') }}
        attributes:
          component: lights
          source: [[ room.illuminance ]]
[%- endif %]
[%- if room.distance is defined and room.distance is not none %]
  # The distance the presence sensor last saw someone at, for the switch-off line in the logbook:
  # by the time the room counts as empty the sensor reads 0.
  - triggers:
      - trigger: state
        entity_id: [[ room.distance ]]
    sensor:
      [%- set label = room.name ~ ' presence last distance' %]
      - name: [[ label | yaml ]]
        unique_id: lights_presence_[[ id ]]_last_distance
        default_entity_id: sensor.lights_presence_[[ id ]]_last_distance
        state: >-
          {% set d = states('[[ room.distance ]]') | float(0) %}
          {{ d if is_state('[[ room.presence ]]', 'on') and d > 0 else this.state }}
        attributes:
          component: lights
[%- endif %]
[%- endfor %]

input_boolean:
[%- for room in presence_rooms %]
[%- set id = room.id | default(room.group.split('.', 1)[1]) %]
  # On after the light was switched off by hand in an occupied room: entry does not relight it until
  # the room has been empty for off_after.
  lights_presence_[[ id ]]_hold:
    [%- set label = room.name ~ ' presence hold' %]
    name: [[ label | yaml ]]
    icon: mdi:lightbulb-off-outline
[%- endfor %]
[%- set lit_rooms = presence_rooms | selectattr('illuminance', 'defined') | rejectattr('illuminance', 'none') | list %]
[%- if lit_rooms %]

sensor:
[%- for room in lit_rooms %]
[%- set id = room.id | default(room.group.split('.', 1)[1]) %]
  # Median over 2 minutes: a radar photodiode jumps by tens for a second at a time. keep_last_sample,
  # because a steady reading sends no new state and an emptied window would read as dark at noon.
  - platform: statistics
    # The name makes the entity id: a YAML statistics sensor has no default_entity_id.
    name: Lights presence [[ id ]] illuminance
    unique_id: lights_presence_[[ id ]]_illuminance
    entity_id: sensor.lights_presence_[[ id ]]_ambient
    state_characteristic: median
    max_age: {minutes: 2}
    keep_last_sample: true
    sampling_size: 200
[%- endfor %]
[%- endif %]
[%- endif %]
[%- if presence_rooms %]

# One automation per presence room (SPEC-053), queued so an entry and a switch-off by hand that
# arrive together are handled in order. turn_on carries no data: the bridge restores the room's last
# brightness and colour temperature. Switch-offs happen only while the room is empty; manual_off
# also asks for presence held a few seconds, so it sees a person's own switch-off and not someone
# walking in during this automation's.
automation:
[%- for room in presence_rooms %]
[%- set id = room.id | default(room.group.split('.', 1)[1]) %]
[%- set off_after = room.off_after | default('00:05:00') %]
[%- set hms = off_after.split(':') %]
[%- set minutes_text = '%g' % ((hms[0] | int * 60 + hms[1] | int + hms[2] | int / 60) | round(1)) %]
[%- set lit = "expand(state_attr('" ~ room.group ~ "', 'entity_id') or []) | selectattr('state', 'eq', 'on') | list | count > 0" %]
[%- set has_illuminance = room.illuminance is defined and room.illuminance is not none %]
[%- set has_distance = room.distance is defined and room.distance is not none %]
  # The alias makes the entity id (automation.lights_presence_<id>); the room's name is in the
  # description and in every logbook line.
  - id: lights_presence_[[ id ]]
    alias: Lights presence [[ id ]]
    description: [[ room.name | yaml ]]
    mode: queued
    max: 10
    variables:
      room: [[ room.name | yaml ]]
      text_on: [[ t('ui.presence.on') | yaml ]]
      text_off: [[ t('ui.presence.off') | yaml ]]
    triggers:
      - trigger: state
        entity_id: [[ room.presence ]]
        to: "on"
        id: enter
      # Leaving, and a light switched on in an empty room.
      - trigger: template
        value_template: "{{ [[ lit ]] and is_state('[[ room.presence ]]', 'off') }}"
        for: [[ off_after | yaml ]]
        id: empty_lit
      - trigger: state
        entity_id: [[ room.presence ]]
        to: "off"
        for: [[ off_after | yaml ]]
        id: leave
      - trigger: state
        entity_id: [[ room.group ]]
        from: "on"
        to: "off"
        id: manual_off
      - trigger: state
        entity_id: [[ room.group ]]
        to: "on"
        id: manual_on
    actions:
      - choose:
          - conditions:
              - condition: trigger
                id: enter
              - condition: template
                value_template: "{{ not ([[ lit ]]) }}"
              - condition: state
                entity_id: input_boolean.lights_presence_[[ id ]]_hold
                state: "off"
[%- if has_illuminance %]
              # Unknown or unavailable counts as dark: a room left dark by a restarting sensor is
              # worse than one lit in daylight.
              - condition: template
                value_template: >-
                  {% set m = states('sensor.lights_presence_[[ id ]]_illuminance') | float(none) %}
                  {{ m is none or not has_value('[[ room.illuminance ]]') or m < [[ room.dark_below ]] }}
[%- endif %]
            sequence:
              - action: light.turn_on
                target: {entity_id: [[ room.group ]]}
              - action: logbook.log
                data:
                  name: "{{ room }}"
                  entity_id: [[ room.group ]]
                  message: >-
                    {{ text_on | replace('{value}', [% if has_illuminance %]states('sensor.lights_presence_[[ id ]]_illuminance')[% else %]'—'[% endif %]) }}
          - conditions:
              - condition: trigger
                id: empty_lit
            sequence:
              - action: light.turn_off
                target: {entity_id: [[ room.group ]]}
              - action: logbook.log
                data:
                  name: "{{ room }}"
                  entity_id: [[ room.group ]]
                  message: >-
                    {{ text_off | replace('{minutes}', '[[ minutes_text ]]')
                       | replace('{distance}', [% if has_distance %]states('sensor.lights_presence_[[ id ]]_last_distance')[% else %]'—'[% endif %]) }}
          - conditions:
              - condition: trigger
                id: manual_off
              # For a few seconds: someone walking back in while this automation switches off
              # is not a switch-off by hand.
              - condition: state
                entity_id: [[ room.presence ]]
                state: "on"
                for: "00:00:05"
            sequence:
              - action: input_boolean.turn_on
                target: {entity_id: input_boolean.lights_presence_[[ id ]]_hold}
          - conditions:
              - condition: trigger
                id: [leave, manual_on]
            sequence:
              - action: input_boolean.turn_off
                target: {entity_id: input_boolean.lights_presence_[[ id ]]_hold}

  # A restart cancels a running `for`, and a template trigger already true at start does not fire:
  # a room left lit and empty is switched off here once off_after has passed without presence.
  - id: lights_presence_[[ id ]]_start
    alias: Lights presence [[ id ]] start
    description: [[ room.name | yaml ]]
    mode: single
    variables:
      room: [[ room.name | yaml ]]
      text_off: [[ t('ui.presence.off') | yaml ]]
    # A reload of automations, and switching the paused room back on, also leave a lit empty room
    # without a running `for`.
    triggers:
      - trigger: homeassistant
        event: start
      - trigger: event
        event_type: automation_reloaded
      - trigger: state
        entity_id: automation.lights_presence_[[ id ]]
        from: "off"
        to: "on"
    conditions:
      - condition: template
        value_template: "{{ [[ lit ]] and is_state('[[ room.presence ]]', 'off') }}"
    actions:
      - wait_for_trigger:
          - trigger: state
            entity_id: [[ room.presence ]]
            to: "on"
        timeout: [[ off_after | yaml ]]
        continue_on_timeout: true
      - if:
          - condition: template
            value_template: "{{ wait.trigger is none }}"
        then:
          - action: light.turn_off
            target: {entity_id: [[ room.group ]]}
          - action: logbook.log
            data:
              name: "{{ room }}"
              entity_id: [[ room.group ]]
              message: >-
                {{ text_off | replace('{minutes}', '[[ minutes_text ]]')
                   | replace('{distance}', [% if has_distance %]states('sensor.lights_presence_[[ id ]]_last_distance')[% else %]'—'[% endif %]) }}
[%- endfor %]
[%- endif %]
