[# Keep read identity and expose only explicitly configured proxy indirection to controls. #]
[%- from 'assistant-bindings.yaml.j2' import binding with context -%]
[%- set groups = {} -%]
[%- for room in inputs.get('rooms', []) if room.get('group') -%]
[%- set entity = 'light.room_' ~ room.get('id', room.group.split('.', 1)[1]) -%]
[%- if entity not in groups -%]
[%- set _ = groups.update({entity: {'entity': room.group}}) -%]
[%- endif -%]
[%- endfor -%]
[%- set subjects = [] -%]
[%- for subject in binding.subjects -%]
[%- set target = dict(subject) -%]
[%- if subject.key in groups -%]
[%- set _ = target.update({'group': groups[subject.key]}) -%]
[%- endif -%]
[%- set _ = subjects.append(target) -%]
[%- endfor -%]
[%- set actions_binding = {'subjects': subjects, 'policies': []} -%]
[[ actions_binding | yaml ]]
