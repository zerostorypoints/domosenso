[%- set subjects = [] -%]
[%- macro add(key, kind, label, fields, extra={}) -%]
[%- set clean = {} -%]
[%- for role, entity in fields.items() if entity -%][%- set _ = clean.update({role: {'entity': entity}}) -%][%- endfor -%]
[%- if clean and key not in (subjects | map(attribute='key') | list) -%]
[%- if label is mapping -%][%- set normalized = {'en': label.values() | first} -%][%- for k,v in label.items() if k in ('en','de','pl') -%][%- set _ = normalized.update({k:v}) -%][%- endfor -%][%- else -%][%- set normalized = label -%][%- endif -%]
[%- set subject = {'key':key, 'kind':kind, 'label':normalized, 'fields':clean} -%][%- set _ = subject.update(extra) -%][%- set _ = subjects.append(subject) -%]
[%- endif -%][%- endmacro -%]
[% set seen = [] %][% for item in inputs.get('rooms', []) if item.get('group') %][% set group = item.group %][% set entity = 'light.room_' ~ item.get('id', group.split('.',1)[1]) %][% set _ = add(entity,'light',item.name,{'light':entity}) %][% set _ = seen.append(group) %][% endfor %][% for item in inputs.get('lights', []) if item.get('entity') and item.entity not in seen %][% set _ = add(item.entity,'light',item.get('label',item.entity),{'light':item.entity}, {'roomKey':item.room} if item.get('room') else {}) %][% endfor %]
[%- set binding = {'subjects':subjects,'policies':[]} -%]
[[ binding | yaml ]]
