# Never in the home repository, even a private one: secrets, tokens, Home Assistant's own state.
# ESPHome's secrets.yaml and a gate's captured code live in the home's private folder,
# ~/.config/domosenso/homes/<id>/; the home holds git-ignored links (`domosenso private`, SPEC-035).
secrets.yaml
*.code.yaml
token
*.token
.storage/
home-assistant_v2.db*

# The command's working data: backups, snapshots, the catalog cache.
.domosenso/

# A local staging Home Assistant's data.
staging/.data*/
