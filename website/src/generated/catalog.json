    {
      "id": "awnings",
      "version": "0.2.1",
      "sourceTag": "awnings/0.2.1",
      "sourceCommit": "67a289d6e61bc7325f389f068c38610262a09c1f",
      "summary": "Somfy RTS awnings through an ESPSomfy-RTS radio node (ESP32 + CC1101), with the awnings' wind sensor",
      "requirements": [
        {
          "kind": "rts-awning",
          "brand": "Somfy",
          "protocol": "Somfy RTS, 433 MHz",
          "note": "each awning is paired to the node as one more virtual remote; a Telis handset keeps working and the node follows it"
        },
        {
          "kind": "esp32-board",
          "recommend": [
            "m5stack-atom-lite"
          ],
          "count": 1,
          "note": "runs ESPSomfy-RTS firmware, not ESPHome, so it is not a Bluetooth proxy; a second board is needed for those"
        },
        {
          "kind": "radio-transceiver",
          "recommend": [
            "cc1101"
          ],
          "note": "the module's band has to match the awnings (433.42 MHz for Somfy RTS in Europe); wired to the board over SPI"
        },
        {
          "kind": "mqtt-broker",
          "note": "the home provides it (Mosquitto, for example); the node and the frame bridge publish to it"
        }
      ],
      "integrations": [
        {
          "name": "mqtt",
          "source": "core",
          "setup": "an MQTT broker (Mosquitto); the node publishes under its own root topic"
        },
        {
          "name": "espsomfy-rts",
          "source": "firmware",
          "repo": "rstrouse/ESPSomfy-RTS",
          "tested": "2.4.6",
          "setup": "flashed over USB, then Wi-Fi and the radio pins in its web page; pair each awning from its own virtual remote"
        }
      ],
      "optionalRequirements": [
        {
          "kind": "wind-sensor",
          "brand": "Somfy",
          "feature": "wind"
        }
      ],
      "installationRole": "installs",
      "testedHa": [
        "2026.9.2"
      ],
      "testedEspHome": [],
