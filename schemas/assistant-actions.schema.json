              "id": {
                "enum": [
                  "lights.turn_on",
                  "lights.turn_off",
                  "awnings.extend",
                  "awnings.retract",
                  "awnings.stop"
                ]
              },
              "operation": {
                "const": "write"
              },
              "action_type": {
                "const": "control-action.v1"
              },
              "result_type": {
                "const": "control-result.v1"
              },
              "effect": {
                "enum": [
                  "turn_on",
                  "turn_off",
                  "extend",
                  "retract",
                  "stop"
                ]
