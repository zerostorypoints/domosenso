            "additionalProperties": false,
            "required": [
              "revision",
              "title_key",
              "description_key",
              "examples_key",
              "id",
              "operation",
              "action_type",
              "result_type",
              "effect",
              "parameters",
              "confirmation",
              "required_facts",
              "optional_facts"
            ]
          }
        ]
      }
    }
