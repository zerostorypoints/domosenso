                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z][a-z0-9_-]*$",
                      "enum": [
                        "light",
                        "cover",
                        "wind",
                        "last_heard"
                      ]
                    },
                    "type": {
                      "enum": [
                        "number",
                        "state",
                        "event",
                        "estimate",
                        "metadata"
                      ]
                    },
                    "units": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      },
                      "minItems": 0,
                      "maxItems": 16
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "relation": {
                          "enum": [
                            "provides",
                            "upstream",
